{#
  Traefik routing for a merod TEE node.

  Every `/admin-api/` path goes through `auth-node` forwardAuth (the `node-api`
  router) except the handful given their own router above it. Adding a path to
  that exempt set is a security decision, so each one carries its reason here.
#}
http:
  routers:
{% if fleet_delegated_access | default(false) | bool %}
    # Delegated execution. One of the delegated paths on this node that a
    # caller with no account here may reach (the others, delegated presence,
    # context creation and governance, are the next routers), and the reason
    # it is exempt from `auth-node` is that it carries its own credential:
    #
    #   * the body holds a WARRANT signed by the author's device key, which
    #     commits to this context, this method and these exact arguments;
    #   * merod refuses it unless the warrant is unexpired, its nonce unspent,
    #     and this node holds `CAN_AUTHOR_ON_BEHALF` on the group owning the
    #     context — all before anything is executed or published;
    #   * the resulting delta is attributed to the AUTHOR, and every peer
    #     re-checks both signature layers and re-authorizes it at the cut.
    #
    # A node token would prove none of that, and requiring one makes the
    # feature unreachable for exactly the callers it exists for: a browser tab
    # or an agent holding one signing key and no relationship with this node.
    #
    # `PathRegexp` pins the shape rather than a prefix: a 64-hex context id and
    # the literal `intents`, anchored at both ends. A `PathPrefix` on
    # `/admin-api/contexts/` would have exempted every context route on the
    # node, `DELETE` included.
    #
    # This router exists only when the image is built as a relay
    # (`fleet_delegated_access`), and it is paired with merod's own
    # `server.admin.delegated_access` — set from the same variable in
    # calimero-init. Both edges move together or the posture is decided in one
    # place and documented in another.
    node-api-intents:
      rule: "PathRegexp(`^/admin-api/contexts/[0-9a-f]{64}/intents$`) && (Method(`GET`) || Method(`POST`) || Method(`OPTIONS`))"
      entryPoints:
        - web
        - websecure
      service: node-core
      # Rate limit BEFORE anything else: a middleware chain runs in order, so a
      # limit placed after `cors` still pays for the headers, and one placed
      # after `auth-node` would pay for a forwardAuth subrequest per flooded
      # request — turning a flood of this node into a flood of its auth service
      # too.
      middlewares:
        - rate-limit-public
        - cors
      priority: 98

    # Delegated PRESENCE: an account's ephemeral presence, published through
    # this relay. Exempt from `auth-node` for the same reason as
    # `node-api-intents`: the body holds a presence statement signed by the
    # device key, plus the account proof tying that device to its account, and
    # the signature is the credential, as a warrant is for `/intents`. merod
    # checks both, refuses a statement outside a short freshness window, and
    # forwards the update; receivers keep only the highest seq per device. It
    # runs nothing, spends no warrant nonce and changes no state.
    #
    # POST only (and OPTIONS for the CORS preflight): there is no descriptor,
    # so a `GET` falls to `node-api` and its `auth-node`. `PathRegexp` pins the
    # shape: a 64-hex context id and the literal `presence-intents`, anchored
    # at both ends, so neither this pattern nor the `/intents` one can match
    # the other's path.
    #
    # Relay-only, and paired with merod's `server.admin.delegated_access`, which
    # serves this route on the same router as `/intents`.
    node-api-presence-intents:
      rule: "PathRegexp(`^/admin-api/contexts/[0-9a-f]{64}/presence-intents$`) && (Method(`POST`) || Method(`OPTIONS`))"
      entryPoints:
        - web
        - websecure
      service: node-core
      middlewares:
        - rate-limit-public
        - cors
      priority: 98

    # Delegated context CREATION: the same posture as `node-api-intents` above,
    # for the one write an intent cannot express, because the context it would
    # name does not exist yet. Exempt from `auth-node` for the same reason:
    #
    #   * the body holds a CREATION WARRANT signed by the author's device key,
    #     committing to this group, the context seed, the application, the
    #     exact `init` arguments (by hash) and this relay as executor;
    #   * merod refuses it unless the AUTHOR holds `CAN_CREATE_CONTEXT` (or is
    #     an admin) in the group, the warrant is unexpired and its nonce
    #     unspent, and this node may act for members there (`RelayTee`, or
    #     `CAN_AUTHOR_ON_BEHALF`). The relay needs no create right of its own;
    #   * `init` runs as the author's account, and every peer re-checks the
    #     warrant when it applies `ContextRegisteredOnBehalf`.
    #
    # `GET` is the descriptor (the executor account to put in the warrant, and
    # whether this relay can create here) and takes an optional
    # `?author=<hex>`. The query string needs no room in the pattern: Traefik
    # matches `PathRegexp` against the request path only (its routing path is
    # built from `URL.EscapedPath()`), never the query.
    #
    # `PathRegexp` pins the shape, as above: a 64-hex group id and the literal
    # `context-intents`, anchored at both ends. A `PathPrefix` on
    # `/admin-api/groups/` would have exempted every group route on the node —
    # `/admin-api/groups/<id>/contexts`, membership, capabilities, deletion —
    # all of which stay behind `auth-node` on `node-api`.
    #
    # Relay-only, and paired with merod's `server.admin.delegated_access`, which
    # serves this route on the same router as `/intents`.
    node-api-context-intents:
      rule: "PathRegexp(`^/admin-api/groups/[0-9a-f]{64}/context-intents$`) && (Method(`GET`) || Method(`POST`) || Method(`OPTIONS`))"
      entryPoints:
        - web
        - websecure
      service: node-core
      middlewares:
        - rate-limit-public
        - cors
      priority: 98

    # Delegated GOVERNANCE: the same posture as the two routers above, for a
    # group governance change a member signs and a relay submits for them.
    # Exempt from `auth-node` for the same reason: the body holds a GOVERNANCE
    # WARRANT signed by the member's device key, and merod verifies it (the
    # signer's membership and rights in the group, expiry, nonce, and that this
    # node may act for members there) before anything is applied. A node token
    # would prove none of that.
    #
    # `GET` is the descriptor a client reads first. As above, Traefik matches
    # `PathRegexp` against the path only, so a query string needs no room in
    # the pattern.
    #
    # `PathRegexp` pins the shape: a 64-hex group id and the literal
    # `governance-intents`, anchored at both ends. Every other group route
    # (`/admin-api/groups/<id>/members`, `/contexts`, capabilities, deletion)
    # stays behind `auth-node` on `node-api`.
    #
    # Relay-only, and paired with merod's `server.admin.delegated_access`, which
    # serves this route on the same router as `/intents`.
    node-api-governance-intents:
      rule: "PathRegexp(`^/admin-api/groups/[0-9a-f]{64}/governance-intents$`) && (Method(`GET`) || Method(`POST`) || Method(`OPTIONS`))"
      entryPoints:
        - web
        - websecure
      service: node-core
      middlewares:
        - rate-limit-public
        - cors
      priority: 98

    # Sealed transport: a client (a browser, above all) attests this node's
    # transport key and seals its requests to it, so the warrant and the
    # method's arguments of an intent are readable only inside the TD, not here
    # at the ingress where TLS ends. Traefik sees `POST /sealed/v2` and an
    # opaque body, nothing more.
    #
    # Exempt from `auth-node` because it could not apply it: the route a sealed
    # request names is inside the envelope, where forwardAuth cannot look. That
    # is safe ONLY because merod enforces the same boundary itself. In proxy
    # auth mode (these nodes), merod lets an opened request reach nothing but
    # what it serves without a credential: the intents, presence-intents,
    # context-intents and governance-intents routes above, and the probes and public TEE routes. Which inner paths
    # count is merod's decision, not this file's: there is no allowlist here
    # to keep in step, and a route merod serves on its delegated router is
    # reachable sealed exactly when it is reachable unsealed. Anything `auth-node` would have guarded is
    # refused inside the envelope with `sealed_route_unguarded`. That check
    # arrived in merod 0.11.0-rc.52; an older merod routes an opened request
    # anywhere, and would turn this router into a bypass of every guard on the
    # node. `traefik-sealed-route-test.sh` refuses this router with an older
    # `merodVersion`.
    #
    # Exact paths, and POST only: the handshake and the exchange are the whole
    # envelope surface. Paired with the intents routers because delegated
    # intents, creations and governance changes are the only writes a sealed
    # request can do here.
    node-sealed:
      rule: "(Path(`/sealed/v2/handshake`) || Path(`/sealed/v2`)) && (Method(`POST`) || Method(`OPTIONS`))"
      entryPoints:
        - web
        - websecure
      service: node-core
      middlewares:
        - rate-limit-public
        - cors
      priority: 96

{% endif %}
    # Direct admission. The other path a caller with no account here may reach,
    # and exempt for the same reason: the request carries its own authority.
    #
    #   * the body holds a join op ALREADY SIGNED by the joiner's device key,
    #     and every peer checks `signer == credential.statement.sign_pk` when
    #     applying it — so this node cannot admit anyone but the signer;
    #   * merod refuses it unless THIS node's account appears in the
    #     invitation's `admitters` list, which the inviter signed. That list is
    #     the per-namespace gate: a relay can publish joins into a namespace
    #     whose admin named it, and into no other;
    #   * the invitation itself must verify — inviter's signature, the group
    #     really in this namespace, the inviter permitted to invite, unexpired.
    #
    # So a hostile caller gains nothing by reaching this route, and a hostile
    # ADMITTER can only refuse to publish: it cannot admit a different account,
    # alter the group, or grant itself a role, because all of that sits inside a
    # signature it does not hold.
    #
    # Requiring a node credential here would make the feature unreachable for
    # exactly its intended caller — a joiner holding an account key and a device
    # certificate signed offline, with no node of its own to publish from. That
    # is the whole case direct admission exists for.
    #
    # UNGATED, unlike `/intents` above, because the two are different kinds of
    # capability. Delegated execution is a HOSTED service: the node authors on
    # someone's behalf, which is what a fleet relay is assigned and paid to do,
    # so it belongs behind `fleet_delegated_access`. Admission is not hosted
    # and involves no cloud at all — the `admitters` list is chosen by the
    # INVITER, who may name any node, including a peer's self-hosted one. Two
    # people running their own nodes can invite and admit with no account
    # anywhere, and gating this on a fleet variable would have made a
    # peer-to-peer flow a cloud-only feature.
    #
    # Serving it everywhere grants no node any authority it did not already
    # have: a node named in no invitation's `admitters` list refuses every
    # request to this route, whatever image it runs.
    #
    # The cost of the wider exposure is that any node will verify signatures for
    # an unauthenticated caller, so this is a request-rate surface like any other
    # public route. It is bounded by the same checks refusing early, but a node
    # under load is worth watching.
    #
    # `PathRegexp` pins the shape for the same reason as above: a 64-hex
    # namespace id (merod parses it as hex-encoded 32 bytes) and the literal
    # `admit`, anchored at both ends. A `PathPrefix` on `/admin-api/namespaces/`
    # would have exempted namespace creation and deletion with it. Lowercase
    # hex only, matching the intents router; an uppercase id falls through to
    # `node-api` and is refused, which is the safe direction.
    #
    # No merod-side pair exists for this one, and none is needed: `/admit` sits
    # in merod's protected router, but these nodes run merod in its default
    # proxy auth mode, so that router carries no guard and traefik is the only
    # gate. A deployment running merod with `--auth-mode embedded` would need a
    # core-side opener as `delegated_access` is for intents.
    node-api-admit:
      rule: "PathRegexp(`^/admin-api/namespaces/[0-9a-f]{64}/admit$`) && (Method(`POST`) || Method(`OPTIONS`))"
      entryPoints:
        - web
        - websecure
      service: node-core
      middlewares:
        - rate-limit-public
        - cors
      priority: 97

    node-api-health:
      rule: "Path(`/admin-api/health`)"
      entryPoints:
        - web
        - websecure
      service: node-core
      # On the generous tier, not exempt. Monitoring polls this a few times a
      # minute, so 100/s never touches it — but an unlimited route is an
      # unlimited route, and this one answers before any auth runs.
      middlewares:
        - rate-limit
        - cors
      priority: 100

    # The two TEE routes merod serves without authentication, and ONLY those
    # two: `GET /admin-api/tee/info` and `POST /admin-api/tee/attest` (core's
    # `tee::service()`, the public half of crates/server/src/admin/handlers/tee.rs).
    #
    # This used to be `PathPrefix(/admin-api/tee)`, which also exempted
    # `POST /admin-api/tee/fleet-join` -- a STATE CHANGE (the node joins a
    # group) that core mounts on `tee::protected_service()`. These nodes run
    # merod in proxy auth mode, so traefik is the only guard that route has,
    # and the prefix removed it. Anything not matched exactly here now falls to
    # `node-api` and `auth-node`.
    #
    # The fleet sidecar is unaffected: it runs `meroctl tee fleet-join` with
    # the local `--home`, which talks to merod on 127.0.0.1:2428 directly and
    # never passes through this ingress; its `/attest` call is loopback too.
    node-api-tee:
      rule: "(Path(`/admin-api/tee/info`) && (Method(`GET`) || Method(`HEAD`) || Method(`OPTIONS`))) || (Path(`/admin-api/tee/attest`) && (Method(`POST`) || Method(`OPTIONS`)))"
      entryPoints:
        - web
        - websecure
      service: node-core
      middlewares:
        - rate-limit
        - cors
      priority: 99

    node-api:
      rule: "PathPrefix(`/jsonrpc`) || PathPrefix(`/admin-api/`)"
      entryPoints:
        - web
        - websecure
      service: node-core
      middlewares:
        - rate-limit
        - cors
        - auth-node
      priority: 10

    node-ws:
      rule: "PathPrefix(`/ws`)"
      entryPoints:
        - web
        - websecure
      service: node-core
      middlewares:
        - rate-limit
        - cors
        - auth-node

    # Server-sent events, the other half of the event stream next to `/ws`:
    # the same credential and the same gate. A browser client subscribes here
    # (its session token rides in an `Authorization` header, which a fetch-based
    # SSE client can send and a browser WebSocket cannot), so without this router every
    # `/sse` request, its CORS preflight included, fell through to Traefik's
    # bare 404, which a browser reports as a CORS failure.
    node-sse:
      rule: "PathPrefix(`/sse`)"
      entryPoints:
        - web
        - websecure
      service: node-core
      middlewares:
        - rate-limit
        - cors
        - auth-node

    node-dashboard:
      rule: "PathPrefix(`/admin-dashboard`)"
      entryPoints:
        - web
        - websecure
      service: node-core
      middlewares:
        - rate-limit
        - cors

    auth-public:
      rule: "PathPrefix(`/auth/`) || PathPrefix(`/admin/`)"
      entryPoints:
        - web
        - websecure
      service: auth-service
      # The only unauthenticated route that mints state: a challenge is stored
      # per request. On the generous tier rather than the tight one because the
      # login flow is several round trips and the browser does them back to
      # back, but it is limited, which it was not.
      middlewares:
        - rate-limit
        - cors

    # No public `/metrics` router. It was gated on a basicAuth users file
    # nothing ever wrote, so traefik logged `open /etc/traefik/metrics-users: no
    # such file` on every boot and the route served no one. Metrics leave the
    # node the other way: vmagent scrapes merod on 127.0.0.1 and remote-writes
    # with the instance's observability token (roles/vmagent).

  services:
    node-core:
      loadBalancer:
        servers:
          - url: "http://127.0.0.1:2428"

    auth-service:
      loadBalancer:
        servers:
          - url: "http://127.0.0.1:3001"

  middlewares:
    # Request-rate limits.
    #
    # Five routes on this ingress verify signatures for callers holding no
    # credential at all — `node-api-intents`, `node-api-presence-intents`,
    # `node-api-context-intents`, `node-api-governance-intents` and
    # `node-api-admit` — and that is deliberate: the request carries its own
    # authority, so requiring a node credential would make these features
    # unreachable for exactly the callers they exist for. The cost is that anyone can make a node do Ed25519 work,
    # which the comments on those routers already name as a request-rate surface
    # "worth watching". Nothing was watching it: until now this ingress had three
    # middlewares and none of them limited anything.
    #
    # `sourceCriterion` is set EXPLICITLY rather than left to default, even
    # though the default is the same. These VMs terminate their own TLS and see
    # the real client address, so per-IP is per-caller. Put a load balancer or a
    # CDN in front and every request arrives from one address: the per-IP limit
    # silently becomes a global one and the fleet throttles itself under normal
    # traffic. Whoever adds that hop must change this block, and an explicit
    # value is what makes it visible enough to change.
    #
    # Traefik counts these in memory, per instance. One instance per node, so a
    # limit here bounds one node rather than the fleet — which is the right
    # granularity: the resource being protected is this node's CPU.
    rate-limit-public:
      rateLimit:
        # Well above any real client — a delegated caller signs a warrant and
        # submits it, it does not stream — and low enough that one address
        # cannot keep a core busy verifying signatures.
        average: 20
        burst: 40
        period: 1s
        sourceCriterion:
          ipStrategy:
            depth: 0

    rate-limit:
      rateLimit:
        # Generous on purpose. A browser app can fire dozens of requests on one
        # page load, and a limit that trips during ordinary use would be read as
        # a node fault and worked around by raising it blindly. This bounds a
        # flood without ever touching real traffic.
        average: 100
        burst: 200
        period: 1s
        sourceCriterion:
          ipStrategy:
            depth: 0

    cors:
      headers:
        accessControlAllowMethods: GET,OPTIONS,PUT,POST,DELETE
        accessControlAllowHeaders: "*"
        accessControlAllowOriginList: "*"
        accessControlMaxAge: 100
        addVaryHeader: true
        accessControlExposeHeaders: X-Auth-Error

    # `trustForwardHeader: false` is what makes the route mero-auth checks the
    # route the caller actually asked for. mero-auth's `/auth/validate` decides
    # a scoped token from `X-Forwarded-Uri` / `X-Forwarded-Method`, and with
    # `true` Traefik passes on whatever the CLIENT put in those headers. A token
    # scoped to route A could then reach route B by sending
    # `X-Forwarded-Uri: A`. With `false`, Traefik discards the client's values
    # and sets them from the request it is routing.
    #
    # Nothing sits in front of this Traefik to be trusted: it is the node's
    # ingress, and the caller is whoever connected. Pinned by
    # scripts/ci/tests/traefik-forward-auth-test.sh (mero-tee#339).
    auth-node:
      forwardAuth:
        address: "http://127.0.0.1:3001/auth/validate"
        trustForwardHeader: false
        # `X-Auth-Account` / `X-Auth-Device` name a device-key session's account
        # and device; merod scopes the caller by them (`server.proxy_identity`).
        # Traefik REPLACES each listed header on the forwarded request, so a
        # client cannot supply its own on a guarded route. Every other route is
        # covered by `strip-proxy-identity` on the entrypoints.
        authResponseHeaders:
          - X-Auth-User
          - X-Auth-Permissions
          - X-Auth-Account
          - X-Auth-Device

    # Removes the two headers merod reads a caller's identity from, on EVERY
    # request, before any router runs: attached to both entrypoints in
    # config.yml, not to routers, so a router added later cannot forget it.
    #
    # Needed because some routes skip `auth-node` — intents, presence-intents,
    # context-intents, governance-intents, admission, the sealed envelope, the auth service itself — and on those
    # nothing else would overwrite a client's `X-Auth-Account`. merod
    # (`server.proxy_identity`) would then read it as the caller and scope the
    # request as that account.
    # On guarded routes `auth-node` runs after this and sets them from
    # mero-auth's answer. An empty value is Traefik's spelling of "delete".
    # Pinned by scripts/ci/tests/traefik-proxy-identity-test.sh.
    strip-proxy-identity:
      headers:
        customRequestHeaders:
          X-Auth-Account: ""
          X-Auth-Device: ""


# The certificate served on `websecure`, for every hostname.
#
# A FIXED PATH, not a hostname, and that is the point. Traefik's own ACME
# resolver would need this node's name in config — a `certificatesResolvers`
# block, `tls.domains`, or a `Host()` rule on each router — and this file is
# rendered into the image, so a per-node name here gives every node a different
# root hash and therefore a different MRTD. A fleet whose measurement differs
# per machine cannot be allowlisted, which is what attestation is for.
#
# The rule that survives: no per-node value may enter a measured file. This path
# is identical on every node; only the bytes behind it differ, and `/mnt/data`
# was never measured. So the certificate is issued elsewhere — mdma orders it
# over ACME DNS-01 for the name the node committed to in its attestation quote,
# and the fleet sidecar installs the chain here.
#
# `defaultCertificate` rather than a `certificates` list because the node does
# not know its own name: it answers on whatever SNI arrives, and the one
# certificate it holds is the right one by construction.
#
# calimero-init generates the key and a self-signed placeholder before traefik
# starts, so this store always loads. Until mdma issues, the node serves :80
# normally and :443 with an untrusted certificate that nothing is pointed at —
# mdma advertises no relay URL until the real chain is in place.
tls:
  stores:
    default:
      defaultCertificate:
        certFile: /mnt/data/tls/cert.pem
        keyFile: /mnt/data/tls/key.pem
