{
  "manifest_version": 3,
  "name": "Calimero Frontend Verifier",
  "version": "0.1.0",
  "description": "Checks every file of a Calimero app's page against what its attested node verified, and stops one that was changed before the page runs it.",
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": "icon-128.png"
  },
  "icons": {
    "128": "icon-128.png"
  },
  "permissions": [
    "webRequest",
    "webRequestBlocking",
    "webRequestFilterResponse",
    "storage",
    "notifications"
  ],
  "host_permissions": [
    "https://*.apps.calimero.network/*",
    "https://*.apps.relay.staging.cloud.calimero.network/*",
    "https://*.calimero.network/*"
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "frontend-verifier@calimero.network",
      "strict_min_version": "128.0"
    }
  }
}
