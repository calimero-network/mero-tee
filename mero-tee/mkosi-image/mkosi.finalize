#!/bin/bash
# Applies the roles' unit masks, then checks this root just before it is sealed
# into EROFS: the units, the libraries, and on locked-read-only the lockdown
# checks of merotee-conformance, which the renderer skips. (Package checks are in build.sh, from mkosi's manifest: dpkg's
# database is gone by now, CleanPackageMetadata=yes.)
set -euo pipefail
root="${BUILDROOT}"

# The roles' masks (lockdown R2/R3/R5/R8/R9 among them), after mkosi's
# preset-all, which would otherwise remove masked template instances. Plus the
# first-boot prompts: an empty machine-id makes the first boot ask for
# configuration on the console and wait there (mkosi-probe hit this).
while read -r unit; do
  if [[ -n "${unit}" ]]; then systemctl --root="${root}" mask "${unit}"; fi
done < "${SRCDIR}/rendered/mask.list"
systemctl --root="${root}" mask systemd-firstboot.service systemd-homed-firstboot.service

failed=0
fail() { echo "conformance: $*" >&2; failed=1; }

while read -r unit; do
  [[ -z "${unit}" ]] && continue
  target="$(readlink "${root}/etc/systemd/system/${unit}" || true)"
  [[ "${target}" == "/dev/null" ]] || fail "${unit} is not masked ($(ls -la "${root}/etc/systemd/system/${unit}" 2>&1))"
done < "${SRCDIR}/rendered/mask.list"

while read -r unit; do
  [[ -z "${unit}" ]] && continue
  compgen -G "${root}/etc/systemd/system/*.wants/${unit}" >/dev/null || fail "${unit} is not enabled"
done < "${SRCDIR}/rendered/enable.list"

for unit in merotee-hostname.service systemd-networkd.service; do
  compgen -G "${root}/etc/systemd/system/*.wants/${unit}" >/dev/null || fail "${unit} is not enabled"
done
if compgen -G "${root}/etc/systemd/system/*.wants/systemd-pcrlock-*" >/dev/null; then
  fail "a systemd-pcrlock unit is enabled: $(cd "${root}/etc/systemd/system" && echo */systemd-pcrlock-*)"
fi

profile="$(cat "${SRCDIR}/rendered/profile")"
role="$(cat "${SRCDIR}/rendered/role")"

# What each role must ship, and what its init script starts itself, never at
# boot by itself (R7: observability is off until the init finds an endpoint).
# The GCE disk-naming rule and helper are what the node finds its data disk
# by.
case "${role}" in
  node)
    required=(/usr/lib/udev/rules.d/65-gce-disk-naming.rules /usr/lib/udev/google_nvme_id /usr/sbin/nvme
              /usr/local/bin/merod /usr/local/bin/meroctl /usr/local/lib/calimero/init.sh)
    not_at_boot=(merod.service traefik.service node_exporter.service vmagent.service vector.service) ;;
  kms)
    required=(/usr/local/bin/mero-kms /usr/local/lib/mero-kms/init.sh /etc/mero-kms/kms.env /etc/mero-kms/image-profile)
    not_at_boot=(node_exporter.service vmagent.service vector.service) ;;
esac
for unit in "${not_at_boot[@]}"; do
  if compgen -G "${root}/etc/systemd/system/*.wants/${unit}" >/dev/null; then fail "${unit} is enabled"; fi
done
# Every role ships vector, whose journald source does not start without its
# data_dir: an image missing it ships no logs.
required+=(/etc/vector/data)
for path in "${required[@]}"; do
  [[ -e "${root}${path}" ]] || fail "${path} is missing"
done

# The users the roles create (users.list): in the image, each with its group.
while read -r name _; do
  [[ -z "${name}" || "${name}" == root ]] && continue
  grep -q "^${name}:" "${root}/etc/passwd" || fail "user ${name} is missing"
  grep -q "^${name}:" "${root}/etc/group" || fail "group ${name} is missing"
done < "${SRCDIR}/rendered/users.list"

# Lockdown (merod-lockdown and merotee-conformance run on locked-read-only only).
if [[ "${profile}" == "locked-read-only" ]]; then
  if [[ -e "${root}/etc/ssh" ]]; then fail "/etc/ssh exists (R1): $(find "${root}/etc/ssh" | sed "s|^${root}||" | tr '\n' ' ')"; fi
  if [[ -s "${root}/etc/securetty" ]]; then fail "/etc/securetty is not empty (R4)"; fi
else
  [[ -x "${root}/usr/sbin/sshd" ]] || fail "a ${profile} image has no sshd"
fi
[[ "$(awk -F: '$1 == "root" { print substr($2, 1, 1) }' "${root}/etc/shadow")" == "!" ]] || fail "root is not locked (R4)"
if [[ "${role}" == node ]]; then
  # The merotee role's; the KMS journal is in the tmpfs overlay.
  grep -qs '^Storage=volatile' "${root}/etc/systemd/journald.conf.d/60-calimero-volatile.conf" || fail "the journal is not volatile"
fi
if [[ -n "$(find "${root}" -xdev -maxdepth 2 -name 'swap*' -type f -print -quit)" ]]; then fail "a swap file ships in the image"; fi

# Every library the baked binaries link must be in the image. The first boot
# on GCP found merod without libstdc++.so.6: calimero-init stopped and the admin
# API never came up. ldd runs in the image, against its own libraries.
while IFS= read -r -d '' binary; do
  path="${binary#"${root}"}"
  head -c 4 "${binary}" | grep -q $'\x7fELF' || continue
  if missing="$(mkosi-chroot ldd "${path}" </dev/null 2>/dev/null | grep 'not found')"; then
    fail "${path} links a library the image lacks: $(echo "${missing}" | tr -s ' \t\n' ' ')"
  fi
done < <(find "${root}/usr/local/bin" "${root}/usr/local/sbin" "${root}/opt" -type f -perm -u+x -print0 2>/dev/null)

exit "${failed}"
