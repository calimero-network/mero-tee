#!/bin/bash
# Calimero locked-down image init (R6). Uses baked merod/meroctl/mero-auth if present;
# otherwise, on the debug profiles ONLY, downloads them from GitHub (legacy, requires
# merod-version metadata). locked-read-only refuses: see "Binaries" below.
set -euo pipefail

# The log lives in RAM (/run is a tmpfs), not on the boot disk.
#
# TDX protects this VM's memory, not its disks, and the boot disk is as readable
# to the cloud project as the data disk is. Everything this script logs is also
# on stdout, which journald captures -- and journald is volatile on this image
# (see the merotee role), so a file copy under /var/log was the one place this
# log outlived the boot, in plaintext, on a device the host can snapshot. It
# holds no secret today; keeping it off the disk means a future log line cannot
# quietly change that.
LOG_DIR="/run/calimero"
LOG="${LOG_DIR}/calimero-init.log"
mkdir -p "$LOG_DIR"
chmod 0700 "$LOG_DIR"
# Where this log used to be. Removed so an upgraded node stops carrying it.
rm -f /var/log/calimero-init.log /var/log/fleet-sidecar.log
BIN_DIR="/usr/local/bin"
CALIMERO_HOME="/mnt/data/calimero"
CALIMERO_NODE="default"
IMAGE_PROFILE="{{ lockdown_profile }}"
IMAGE_ROLE="node"
MEROD_MODE="{{ merod_mode }}"
METADATA_URL="http://metadata.google.internal/computeMetadata/v1/instance/attributes"
METADATA_HEADER="Metadata-Flavor: Google"

# Whitelisted keys only (no arbitrary script execution)
get_meta() {
  local key="$1"
  curl -sf -H "$METADATA_HEADER" "${METADATA_URL}/${key}" 2>/dev/null || true
}

log() { echo "[$(date -Iseconds)] $*" | tee -a "$LOG"; }

# Defined up front because the data-disk and release-floor checks below refuse
# the boot as well as the storage-encryption decision does.
fatal() {
  log "ERROR: $*"
  exit 1
}

log "Starting Calimero init (profile=$IMAGE_PROFILE mode=$MEROD_MODE)"

# --- Extend RTMR3 (user-defined) for attestation; different per image, cannot be faked ---
# RTMR3 is empty by default; extending with role+profile+root_hash makes each image unique.
# Newer kernels (e.g. 6.17+ GCP) expose RTMR under tdx_guest/measurements/; older use tdx_guest/mr/.
#
# Fatal on locked-read-only: an unextended RTMR3 no longer names this image, so a
# quote from it would not say which image is running. The debug profiles only warn,
# so a kernel without the sysfs interface can still be debugged.
rtmr3_problem() {
  if [[ "$IMAGE_PROFILE" == "locked-read-only" ]]; then
    fatal "RTMR3 not extended: $*"
  fi
  log "WARN: RTMR3 not extended: $*"
}
ROOT_HASH=$(grep -oE 'calimero\.root_hash=[^ ]+' /proc/cmdline 2>/dev/null | cut -d= -f2 || echo "none")
RTMR3_EXTEND_FILE="$(mktemp)"
if printf 'calimero-rtmr3-v2:%s:%s:%s' "$IMAGE_ROLE" "$IMAGE_PROFILE" "${ROOT_HASH}" | openssl dgst -sha384 -binary > "$RTMR3_EXTEND_FILE" 2>/dev/null; then
  # shellcheck disable=SC2002
  RTMR3_EXTEND_SIZE="$(cat "$RTMR3_EXTEND_FILE" | wc -c | tr -d '[:space:]')"
  if [[ "${RTMR3_EXTEND_SIZE}" == "48" ]]; then
    modprobe tdx_guest 2>/dev/null || true
    RTMR3_SYSFS=""
    for candidate in \
      "/sys/class/misc/tdx_guest/measurements/rtmr3:sha384" \
      "/sys/class/misc/tdx_guest/mr/rtmr3:sha384"; do
      if [[ -e "${candidate}" ]] && [[ -w "${candidate}" ]]; then
        RTMR3_SYSFS="${candidate}"
        break
      fi
    done
    if [[ -n "${RTMR3_SYSFS}" ]]; then
      if cat "$RTMR3_EXTEND_FILE" > "${RTMR3_SYSFS}" 2>/dev/null; then
        log "Extended RTMR3 for attestation (role=$IMAGE_ROLE profile=$IMAGE_PROFILE root_hash=${ROOT_HASH:0:16}... via ${RTMR3_SYSFS})"
      else
        rtmr3_problem "write failed (${RTMR3_SYSFS})"
      fi
    else
      rtmr3_problem "no writable rtmr3:sha384 under /sys/class/misc/tdx_guest/measurements/ or .../mr/"
    fi
  else
    rtmr3_problem "extend input has unexpected size (${RTMR3_EXTEND_SIZE}, expected 48)"
  fi
else
  rtmr3_problem "failed to generate the extend input digest"
fi
rm -f "$RTMR3_EXTEND_FILE"

# --- R7: observability off by default; enable only if endpoint set ---
systemctl stop vmagent vector 2>/dev/null || true
systemctl disable vmagent vector 2>/dev/null || true

# Optional with defaults. A port is a decimal number from 1 to 65535; anything
# else in metadata is ignored for the default rather than handed to merod.
metadata_port() {
  local key="$1" default="$2" value
  value=$(get_meta "$key" | tr -d '\r\n')
  if [[ -z "$value" ]]; then
    echo "$default"
  elif [[ "$value" =~ ^[0-9]{1,5}$ ]] && (( 10#$value >= 1 && 10#$value <= 65535 )); then
    echo "$((10#$value))"
  else
    # `log` also writes stdout, which is this function's answer.
    log "WARN: ignoring $key metadata that is not a port; using $default" >&2
    echo "$default"
  fi
}
SERVER_PORT=$(metadata_port "server-port" 2428)
SWARM_PORT=$(metadata_port "swarm-port" 2528)
TEE_RELEASE_VERSION=$(get_meta "tee-release-version")
# The mero-kms endpoint this node's storage key comes from. Stamped by
# mdma's dispatcher at creation. Untrusted like all metadata, and that is fine:
# merod verifies the KMS's own attestation against the signed release policy
# before it accepts a key, so a wrong URL fails the boot rather than handing
# the node a key someone else knows. See "Storage encryption" below.
KMS_URL=$(get_meta "kms-url" | tr -d '\r\n')
# `true` keeps the whole node in RAM (a tmpfs over the data disk's mount point)
# for a VM meant to live minutes: the release pipeline's measurement VM, which
# cannot have a KMS because a release's KMS is published only after its image
# has been measured. Untrusted like all metadata; it relaxes nothing on its own.
# The storage decision below checks that the store IS in memory before it
# allows a node without a KMS. See "The data disk" and "Storage encryption".
EPHEMERAL_STORE=$(get_meta "ephemeral-store" | tr -d '\r\n')
METRICS_ENDPOINT=$(get_meta "metrics-endpoint")
LOGS_ENDPOINT=$(get_meta "logs-endpoint")
# The bearer token vector and vmagent present to the observability front end.
# Stamped per-instance at creation by mdma's dispatcher, the same way
# `enrolment-token` and `relay-url` are. `tr -d` because a metadata value
# carrying a stray newline would be a DIFFERENT credential to the one mdma
# holds, and the mismatch would show up only as 401s at the sink.
OBSERVABILITY_TOKEN=$(get_meta "observability-token" | tr -d '\r\n')

# --- Observability, FIRST ---------------------------------------------------
#
# Started here, straight after the metadata is read and before the binaries, the
# data disk and the KMS -- none of which vector or vmagent depend on. It used to
# be the last thing this script did, so any `fatal` above it (a KMS that could
# not be reached, a data disk that would not open) exited before a shipper ran:
# the node shipped nothing, its sidecar never started, and a locked image has no
# console. The boots that most need their journal were the ones that sent none.
# vector's journald source reads from the start of the boot, so every line this
# script logs, before and after this point, ships.

# --- Observability credential ----------------------------------------------
#
# THE CREDENTIAL ARRIVES AT BOOT, FROM INSTANCE METADATA, and deliberately not
# from the fleet sidecar.
#
# It used to arrive only on the sidecar's `should-join` response. That made the
# observability path depend on the thing it observes: a poll needs a fleet
# token, a fleet token needs attested registration, and registration needs the
# sidecar's main loop to be running. A node whose sidecar never reached its
# first poll could therefore never ship a log line -- which is precisely the
# node whose logs you need. One such node cost two hours of reconstructing its
# internal state from HTTP request counts against the manager, and the question
# it was reconstructed to answer (why its sidecar never started) was still not
# answerable at the end.
#
# Reading it here breaks that circle completely. This script runs before any
# unit does, so vector comes up authenticated whether or not the sidecar ever
# runs, ever registers, or can even reach mdma -- and this script's OWN journal,
# which is where a node that fails before the sidecar says why, ships with it.
#
# The trade: one fleet-wide bearer token now sits in instance metadata rather
# than being a per-node credential handed over an attested channel. That is
# weaker, and it is a deliberate choice. It still keeps the standing rule that
# no secret is baked into the image -- instance metadata is not the image, it
# is per-instance and rotatable without a release or an MRTD re-allowlist --
# and the vmauth user this token names is scoped write-only, so a node that
# leaks it lets someone add junk to the log store, not read the fleet's
# telemetry. Against that: a node with no logs is a node that cannot be
# debugged at all, on a profile with no shell to debug it from.
#
# Not GCP Secret Manager. mdma creates these instances with no
# `serviceAccounts` field at all, so there is no cloud identity to read a
# secret with. The `logs-secret-name` / `metrics-secret-name` keys that used to
# select that path are no longer read, since every node gets its credential
# from mdma.
#
# The same file the fleet sidecar writes on rotation, and written the same way:
# `printf '%s'`, no trailing newline, because mdma compares SHA-256 of the token
# against SHA-256 of this file's contents to decide whether to re-send it. A
# newline here would make every poll disagree and put the credential on the wire
# once a second forever.
OBS_TOKEN_FILE="/etc/vector/provided_token"

if [[ -n "${OBSERVABILITY_TOKEN:-}" ]]; then
  mkdir -p /etc/vector
  OBS_TOKEN_TMP="${OBS_TOKEN_FILE}.$$"
  # `umask` in a subshell, not `chmod` afterwards. This unit sets no `UMask=`,
  # so systemd's default 0022 creates the file 0644 and a post-hoc chmod closes
  # the window only after the secret is already on disk world-readable. The
  # chmod stays as a belt-and-braces assertion of the final mode.
  #
  # Same reasoning, and the same fix, as the sidecar's two token writes. Both
  # files are the SAME credential at the same path, so a difference in how they
  # are created would be a difference nobody would think to look for.
  if ( umask 077; printf '%s' "$OBSERVABILITY_TOKEN" > "$OBS_TOKEN_TMP" ); then
    chmod 600 "$OBS_TOKEN_TMP"
    mv -f "$OBS_TOKEN_TMP" "$OBS_TOKEN_FILE"
    # The FINGERPRINT, never the token. Enough to tell "this node holds the same
    # credential mdma does" apart from "this node holds an old one", which is
    # the only question worth asking from a log.
    log "Observability token installed from instance metadata ($(sha256sum "$OBS_TOKEN_FILE" 2>/dev/null | awk '{print $1}'))"
  else
    rm -f "$OBS_TOKEN_TMP"
    log "WARN: could not write $OBS_TOKEN_FILE; vector and vmagent will push unauthenticated"
  fi
fi

# Which credential a shipper should present, as the (auth, provider, secret)
# triple both configure_vector.sh and configure_vmagent.sh take. Sets globals
# rather than printing, so a caller cannot lose the distinction between the
# three fields in a word split.
OBS_AUTH="false"
OBS_PROVIDER="provided"
OBS_SECRET=""
resolve_obs_auth() {
  if [[ -s "$OBS_TOKEN_FILE" ]]; then
    OBS_AUTH="true"; OBS_PROVIDER="provided"; OBS_SECRET="$OBS_TOKEN_FILE"
  else
    # Still started, not refused. An endpoint with no auth in front of it is a
    # legitimate deployment (an internal ALB, a local collector), and refusing
    # would break it. Unauthenticated against a BEARER-GATED endpoint is the
    # common case and is silent from the node's side -- every write is rejected
    # at the sink and nothing here ever hears about it -- so say so loudly.
    OBS_AUTH="false"; OBS_PROVIDER="provided"; OBS_SECRET=""
  fi
}

# R7: start vmagent only if metrics-endpoint set
if [[ -n "${METRICS_ENDPOINT:-}" ]]; then
  resolve_obs_auth
  [[ "$OBS_AUTH" == "true" ]] || log "WARN: metrics-endpoint is set but this node has no observability credential; vmagent will push unauthenticated and a bearer-gated endpoint will reject every write"
  if [[ -f /etc/vmagent/configure_vmagent.sh ]] && [[ -f /etc/vmagent/scrape_config.yml ]]; then
    # What vmagent is pointed at. The default scrape config targets
    # node_exporter on localhost:9100, and the role that installs node_exporter
    # writes its unit file without ever enabling it -- so before this, a vmagent
    # that started scraped a port with nothing behind it and shipped an empty
    # series set. Started here rather than unconditionally because it is only
    # ever a scrape target: with no metrics endpoint there is nobody to scrape
    # it for.
    if [[ -f /etc/systemd/system/node_exporter.service ]]; then
      systemctl enable --now node_exporter >>"$LOG" 2>&1 \
        || log "WARN: node_exporter did not start; vmagent will scrape nothing"
    else
      log "WARN: node_exporter.service is not installed; vmagent will scrape nothing"
    fi
    /etc/vmagent/configure_vmagent.sh /etc/vmagent/scrape_config.yml "$METRICS_ENDPOINT" "$OBS_AUTH" "$OBS_PROVIDER" "$OBS_SECRET" >>"$LOG" 2>&1 \
      || log "WARN: vmagent configure failed; see $LOG"
  else
    log "WARN: vmagent config or script missing, skipping"
  fi
fi

# R7: start vector only if logs-endpoint set
if [[ -n "${LOGS_ENDPOINT:-}" ]]; then
  resolve_obs_auth
  [[ "$OBS_AUTH" == "true" ]] || log "WARN: logs-endpoint is set but this node has no observability credential; vector will push unauthenticated and a bearer-gated endpoint will reject every write"
  if [[ -f /etc/vector/configure_vector.sh ]] && [[ -f /etc/vector/vector_partial.yaml ]]; then
    /etc/vector/configure_vector.sh /etc/vector/vector_partial.yaml "$LOGS_ENDPOINT" "$OBS_AUTH" "$OBS_PROVIDER" "$OBS_SECRET" >>"$LOG" 2>&1 \
      || log "WARN: vector configure failed; see $LOG"
  else
    log "WARN: vector config or partial missing, skipping"
  fi
fi

# --- Binaries ---------------------------------------------------------------
#
# Use baked binaries if present (image built with calimero-core); else download
# at runtime -- but never on locked-read-only.
#
# The baked binaries are hashed into `calimero.root_hash` on the kernel command
# line, which is measured into RTMR[2]; that is what makes the node's quote say
# WHICH merod it runs. A merod fetched here at boot is in no measurement at all:
# the quote would be identical whatever was downloaded, and `merod-version` is
# instance metadata the cloud project writes. So on the production profile a
# missing binary is a broken image, and the only safe answer is to stop.
if [[ -x "${BIN_DIR}/merod" ]] && [[ -x "${BIN_DIR}/meroctl" ]] && [[ -x "${BIN_DIR}/mero-auth" ]]; then
  log "Using baked merod/meroctl/mero-auth from image"
elif [[ "$IMAGE_PROFILE" == "locked-read-only" ]]; then
  fatal "merod/meroctl/mero-auth are not baked into this image. locked-read-only \
never downloads them at boot: a downloaded binary is covered by no measurement, \
so the node's attestation would vouch for code it never measured. Rebuild the image."
else
  MEROD_VERSION=$(get_meta "merod-version")
  if [[ -z "${MEROD_VERSION:-}" ]]; then
    log "ERROR: merod-version metadata required (binaries not baked in image)"
    exit 1
  fi
  CPU_PLATFORM=$(uname -m)
  BASE_URL="https://github.com/calimero-network/core/releases/download/${MEROD_VERSION}"
  log "merod-version=$MEROD_VERSION server-port=$SERVER_PORT swarm-port=$SWARM_PORT"
  download() {
    local name="$1"
    local tar="${name}_${CPU_PLATFORM}-unknown-linux-gnu.tar.gz"
    log "Downloading $name from $BASE_URL ..."
    wget -q -O "/tmp/${name}.tar.gz" "${BASE_URL}/${tar}"
    tar -xzf "/tmp/${name}.tar.gz" -C "$BIN_DIR"
    chmod 0755 "$BIN_DIR/$name"
    rm -f "/tmp/${name}.tar.gz"
  }
  download merod
  download meroctl
  download mero-auth
fi

log "server-port=$SERVER_PORT swarm-port=$SWARM_PORT"

# --- Release pinning (downgrade protection) ---------------------------------
#
# `tee-release-version` names the signed release whose policy merod verifies
# the KMS against. It is instance metadata, so the cloud project chooses it --
# and EVERY release's policy is validly signed. Without a floor, naming an old
# release whose allowlists accept a KMS build since found wanting is a downgrade
# anyone who can set metadata performs, and a valid signature would bless it.
#
# The floor is this image's own version, baked at build time into a file the
# root hash measures. That is always safe: the KMS release that admits an image
# is cut AFTER that image has been measured (its policy lists the image's
# measurements), so no release older than the image can admit it anyway. merod
# enforces it (`MERO_TEE_MIN_VERSION`, semver); the comparison here is defence
# in depth that fails the boot with a clear line before anything is fetched.
#
# `MERO_TEE_PROFILE` is this image's profile, on EVERY profile. merod fetches
# that profile's signed policy (`kms-attestation-policy.<profile>.json`,
# see release-kms.yaml) and refuses one whose `profile` differs, so a
# node verifies its own profile's KMS against that KMS's measurements, and a
# production node cannot be pointed at a debug release's policy. This needs a
# merod that selects the per-profile asset (calimero-network/core#4069): an
# older one fetches only the default asset, which is the locked-read-only
# policy, and a debug node pinned to its own profile would refuse it.
MIN_TEE_RELEASE_FILE="/etc/calimero/min-tee-release-version"
MIN_TEE_RELEASE_VERSION="$(tr -d '[:space:]' < "$MIN_TEE_RELEASE_FILE" 2>/dev/null || true)"
EXPECTED_TEE_POLICY_PROFILE="$IMAGE_PROFILE"

# True when release $1 is OLDER than release $2. Semver-ish, like merod: the
# `mero-kms-v` prefix is dropped, the numeric cores compare with `sort -V`, and
# on equal cores a pre-release (`-rc.1`) is older than the release itself,
# which `sort -V` alone gets backwards.
release_older_than() {
  local a="${1#mero-kms-v}" b="${2#mero-kms-v}"
  a="${a%%+*}"; b="${b%%+*}"
  local a_core="${a%%-*}" b_core="${b%%-*}"
  if [[ "$a_core" != "$b_core" ]]; then
    [[ "$(printf '%s\n%s\n' "$a_core" "$b_core" | sort -V | head -n1)" == "$a_core" ]]
    return
  fi
  local a_pre="" b_pre=""
  [[ "$a" == *-* ]] && a_pre="${a#*-}"
  [[ "$b" == *-* ]] && b_pre="${b#*-}"
  if [[ -z "$a_pre" ]]; then return 1; fi
  if [[ -z "$b_pre" ]]; then return 0; fi
  [[ "$a_pre" != "$b_pre" ]] \
    && [[ "$(printf '%s\n%s\n' "$a_pre" "$b_pre" | sort -V | head -n1)" == "$a_pre" ]]
}

# EnvironmentFile value: strip line breaks, then quote/escape. Same escaping as
# MERO_TEE_VERSION always had, now shared by the three values written.
env_file_value() {
  local v="${1//$'\n'/}"
  v="${v//$'\r'/}"
  v="${v//\\/\\\\}"
  v="${v//\"/\\\"}"
  printf '%s' "$v"
}

if [[ -n "${TEE_RELEASE_VERSION:-}" ]]; then
  # Prevent EnvironmentFile injection: strip line breaks and quote/escape value.
  SANITIZED_TEE_RELEASE_VERSION=${TEE_RELEASE_VERSION//$'\n'/}
  SANITIZED_TEE_RELEASE_VERSION=${SANITIZED_TEE_RELEASE_VERSION//$'\r'/}
  if [[ -n "$MIN_TEE_RELEASE_VERSION" ]] \
      && release_older_than "$SANITIZED_TEE_RELEASE_VERSION" "$MIN_TEE_RELEASE_VERSION"; then
    fatal "tee-release-version ${SANITIZED_TEE_RELEASE_VERSION} is older than this \
image (${MIN_TEE_RELEASE_VERSION}). No release older than the image can have \
measured it, so this can only be a downgrade to an older, validly signed policy. \
Refusing to start; set tee-release-version to ${MIN_TEE_RELEASE_VERSION} or later."
  fi
  {
    printf 'MERO_TEE_VERSION="%s"\n' "$(env_file_value "$SANITIZED_TEE_RELEASE_VERSION")"
    if [[ -n "$MIN_TEE_RELEASE_VERSION" ]]; then
      printf 'MERO_TEE_MIN_VERSION="%s"\n' "$(env_file_value "$MIN_TEE_RELEASE_VERSION")"
    fi
    if [[ -n "$EXPECTED_TEE_POLICY_PROFILE" ]]; then
      printf 'MERO_TEE_PROFILE="%s"\n' "$(env_file_value "$EXPECTED_TEE_POLICY_PROFILE")"
    fi
  } > /etc/calimero/merod.env
  chmod 0644 /etc/calimero/merod.env
  log "Configured MERO_TEE_VERSION=${SANITIZED_TEE_RELEASE_VERSION} (floor=${MIN_TEE_RELEASE_VERSION:-none} policy-profile=${EXPECTED_TEE_POLICY_PROFILE:-any}) from tee-release-version metadata"

  # For everything this script runs itself -- `merod kms disk-key` below and
  # `merod init`. `merod run` reads the same three values from merod.env, so
  # the disk, the store and the running node are verified against one policy.
  export MERO_TEE_VERSION="$SANITIZED_TEE_RELEASE_VERSION"
  if [[ -n "$MIN_TEE_RELEASE_VERSION" ]]; then
    export MERO_TEE_MIN_VERSION="$MIN_TEE_RELEASE_VERSION"
  fi
  if [[ -n "$EXPECTED_TEE_POLICY_PROFILE" ]]; then
    export MERO_TEE_PROFILE="$EXPECTED_TEE_POLICY_PROFILE"
  fi
else
  rm -f /etc/calimero/merod.env
fi

# Extra `merod init` arguments; set by the storage-encryption decision below.
INIT_EXTRA_ARGS=()
INIT_ENCRYPTED=false

init_node() {
  if [[ "$MEROD_MODE" == "read-only" ]]; then
    "$BIN_DIR/merod" --home "$CALIMERO_HOME" --node "$CALIMERO_NODE" init \
      --mode read-only \
      --advertise-address \
      --server-port "$SERVER_PORT" \
      --swarm-port "$SWARM_PORT" \
      ${INIT_EXTRA_ARGS[@]+"${INIT_EXTRA_ARGS[@]}"}
  else
    "$BIN_DIR/merod" --home "$CALIMERO_HOME" --node "$CALIMERO_NODE" init \
      --advertise-address \
      --server-port "$SERVER_PORT" \
      --swarm-port "$SWARM_PORT" \
      ${INIT_EXTRA_ARGS[@]+"${INIT_EXTRA_ARGS[@]}"}
  fi
}

# --- Swap -------------------------------------------------------------------
#
# Swap pages guest memory out to a DISK, and a disk is exactly what TDX does not
# protect: whatever is paged out -- the data-disk key while it sits in its tmpfs
# below, merod's keys, group keys -- lands in plaintext where the host can read
# it. The image ships no swap (the merotee role removes every swap entry and
# masks swap.target on locked-read-only), so this is a boot-time assertion that
# it stayed that way, and it runs BEFORE any key is fetched.
if [[ -n "$(swapon --noheadings 2>/dev/null)" ]]; then
  log "WARN: swap is active on a confidential VM; disabling it before any key is fetched"
  swapoff -a >>"$LOG" 2>&1 || true
  if [[ -n "$(swapon --noheadings 2>/dev/null)" ]]; then
    if [[ "$IMAGE_PROFILE" == "locked-read-only" ]]; then
      fatal "swap is still active after swapoff -a. Memory paged out to it would \
reach a host-readable disk in plaintext. Refusing to continue."
    fi
    log "WARN: swap could not be disabled; keys may be paged to disk (allowed on profile=$IMAGE_PROFILE only)"
  fi
fi

# --- The data disk ----------------------------------------------------------
#
# Every node is created with a separate data disk (200 GB on the current plans)
# and NOTHING WAS MOUNTING IT. `merod` initialised into `/mnt/data/calimero`,
# which was a directory on the ~19 GB root filesystem, so a node had roughly
# 15 GB of usable space while the console advertised 200 -- and when root fills
# it takes merod, traefik, mero-auth, vector and vmagent with it, on a machine
# with no shell to recover from.
#
# The mounting logic existed in mdma (`dispatcher/app/startup_script.py`) but
# was never reachable: nothing attaches a `startup-script` to these instances,
# and `merod-lockdown` blocks GCP startup scripts outright on `locked-read-only`
# (R5). So it has to come from the image, which is here.
#
# `/dev/disk/by-id/google-data` rather than probing `/dev/nvme0n2`: GCP exposes
# every attached disk under its `deviceName`, and mdma attaches this one as
# `data` (`dispatcher/app/gcp/instances.py`). The by-id path is stable
# regardless of NVMe enumeration or attach order; the device-name guessing in
# the old script was not.
#
# THE DISK IS ENCRYPTED (LUKS2, with integrity), keyed from the KMS.
#
# TDX protects memory, not disks, and the cloud project can snapshot, read and
# rewrite this device at will. merod's own store is encrypted from `init
# --kms-url` (below), but the disk holds more than the store: `config.toml`,
# blobs, the node's TLS private key, mero-auth's database, the fleet sidecar's
# token and state. So the whole block device is a dm-crypt mapping:
#
#   * aes-xts-plain64 for confidentiality, and `--integrity hmac-sha256` so an
#     offline edit is DETECTED (the read fails) rather than silently decrypted
#     into garbage merod might act on. XTS alone is malleable; the HMAC is keyed
#     by the volume key, so the host cannot forge a valid sector.
#   * The key is released by mero-kms only to a TD whose quote matches
#     the signed release policy (`merod kms disk-key`), exactly like the store
#     key. It exists only in a RAM-backed directory, for as long as it takes to
#     format or open the disk, and is shredded right after.
#   * The KMS derives the key per IDENTITY: a dedicated libp2p keypair made on
#     the first boot. It is stored in the LUKS2 header as a token, in the clear,
#     by design -- it obtains nothing without a genuine TD to answer the KMS's
#     attestation challenge, and the node needs it BEFORE the disk is open.
#   * pbkdf2 at the minimum 1000 iterations: the passphrase is a full-entropy
#     KMS key, not something a person chose, so a slow KDF would buy no
#     resistance and only cost boot time.
#   * No /etc/fstab entry and no crypttab: neither can unlock it. This script
#     opens it on every boot, before anything writes to /mnt/data.
#
# What this refuses to do, ever: format a device that has ANY signature on it.
# A crypto_LUKS device is opened; a plain ext4 one is mounted as it always was
# (a node that predates this); anything else stops the boot. Only a device
# `blkid -p` positively reports as blank is formatted.
DATA_DEVICE="/dev/disk/by-id/google-data"
DATA_MOUNT="/mnt/data"
DATA_MAPPER_NAME="calimero-data"
DATA_MAPPER="/dev/mapper/${DATA_MAPPER_NAME}"
# A dedicated tmpfs, not just a directory under /run: `merod kms disk-key`
# refuses to write the key anywhere that is not tmpfs/ramfs, and a mount of our
# own makes that true by construction, with nothing else in it and mode 0700.
DISK_KEY_DIR="/run/calimero-disk"
DISK_KEY_FILE="${DISK_KEY_DIR}/data-disk.key"
DISK_IDENTITY_FILE="${DISK_KEY_DIR}/data-disk.identity"
DISK_TOKEN_TYPE="calimero-kms-identity"
# A KMS that is briefly unreachable at boot should not brick a node until
# someone reboots it, so the fetch is retried. Overridable only so the test
# does not sleep.
DISK_KEY_ATTEMPTS="${DISK_KEY_ATTEMPTS:-10}"
DISK_KEY_RETRY_DELAY="${DISK_KEY_RETRY_DELAY:-6}"
# What the data disk turned out to be, for the checks after it is mounted:
# ephemeral | encrypted | plaintext | root-legacy | none.
DATA_DISK_STATE="none"

merod_can_unlock_disk() {
  "$BIN_DIR/merod" kms disk-key --help 2>/dev/null | grep -q -- '--key-out'
}

# Shred the key (and drop the identity copy) the moment it is no longer
# needed, and on ANY exit: a `fatal` halfway through a format must not leave
# the key sitting in /run for the life of the boot.
disk_secrets_cleanup() {
  if [[ -e "$DISK_KEY_FILE" ]]; then
    shred -u "$DISK_KEY_FILE" 2>/dev/null || rm -f "$DISK_KEY_FILE"
  fi
  rm -f "$DISK_IDENTITY_FILE"
  if mountpoint -q "$DISK_KEY_DIR" 2>/dev/null; then
    umount "$DISK_KEY_DIR" 2>/dev/null || true
  fi
}
trap disk_secrets_cleanup EXIT

prepare_disk_key_dir() {
  mkdir -p "$DISK_KEY_DIR"
  chmod 0700 "$DISK_KEY_DIR"
  if ! mountpoint -q "$DISK_KEY_DIR" 2>/dev/null; then
    mount -t tmpfs -o mode=0700,size=1m,nosuid,nodev,noexec tmpfs "$DISK_KEY_DIR" >>"$LOG" 2>&1 \
      || fatal "could not mount a tmpfs at $DISK_KEY_DIR for the data-disk key"
  fi
  local fstype
  fstype="$(findmnt -n -o FSTYPE --target "$DISK_KEY_DIR" 2>/dev/null || true)"
  [[ "$fstype" == tmpfs || "$fstype" == ramfs ]] \
    || fatal "$DISK_KEY_DIR is on '$fstype', not tmpfs; the data-disk key must never reach a disk"
  # `--key-out` must not exist yet; a leftover could only be from this boot.
  rm -f "$DISK_KEY_FILE"
}

# Ask the KMS for the data-disk key. `create` also mints the identity (first
# boot only: an existing disk must present the identity it was made with).
# Nothing secret is on merod's stdout, but it goes to the log only anyway.
fetch_disk_key() {
  local args=(kms disk-key --kms-url "$KMS_URL" --identity "$DISK_IDENTITY_FILE" --key-out "$DISK_KEY_FILE")
  if [[ "${1:-}" == create ]]; then
    args+=(--create-identity)
  fi
  local attempt out why
  for attempt in $(seq 1 "$DISK_KEY_ATTEMPTS"); do
    rm -f "$DISK_KEY_FILE"
    out="$("$BIN_DIR/merod" "${args[@]}" 2>&1)" && [[ -s "$DISK_KEY_FILE" ]] && {
      printf '%s\n' "$out" >>"$LOG"
      return 0
    }
    printf '%s\n' "$out" >>"$LOG"
    # merod's error, into the journal: $LOG is on this node's tmpfs, which a
    # locked node has no shell to read, so a reason left only there is lost.
    # disk-key never prints the key (it goes only to --key-out), just the peer
    # id, the key file's path and the error chain.
    why="$(sed -e 's/\x1b\[[0-9;]*m//g' <<<"$out" | grep -v '^[[:space:]]*$' | tail -n 6 | tr '\n' ' ' | cut -c1-800 || true)"
    log "WARN: data-disk key fetch attempt ${attempt}/${DISK_KEY_ATTEMPTS} failed (kms=$KMS_URL release=${TEE_RELEASE_VERSION:-}): ${why:-no output}"
    if (( attempt < DISK_KEY_ATTEMPTS )); then
      sleep "$DISK_KEY_RETRY_DELAY"
    fi
  done
  fatal "could not obtain the data-disk key from the KMS after ${DISK_KEY_ATTEMPTS} attempts \
(kms=$KMS_URL release=${TEE_RELEASE_VERSION:-}). The disk stays locked; see $LOG."
}

# What is on a block device, WITHOUT trusting a cache: `blkid -p` probes the
# device itself. Prints TYPE (or `partition-table:<type>`) and returns 0 when
# something was found; returns 2 ONLY when blkid positively reports nothing
# (its documented "no signature" code); any other status means the probe
# itself failed, and a caller must treat that as "unknown", never as "blank".
probe_signature() {
  local out rc=0
  out="$(blkid -p -o export "$1" 2>>"$LOG")" || rc=$?
  if [[ "$rc" != 0 ]]; then
    return "$rc"
  fi
  local sig_type sig_pttype
  sig_type="$(sed -n 's/^TYPE=//p' <<<"$out" | head -n1)"
  sig_pttype="$(sed -n 's/^PTTYPE=//p' <<<"$out" | head -n1)"
  if [[ -n "$sig_type" ]]; then
    printf '%s' "$sig_type"
  elif [[ -n "$sig_pttype" ]]; then
    printf 'partition-table:%s' "$sig_pttype"
  else
    printf 'unrecognised'
  fi
}

# The identity stored in this disk's LUKS2 header. Exactly one token of our
# type, or nothing: two would make "which identity unlocks this disk" a guess.
read_disk_token_identity() {
  cryptsetup luksDump --dump-json-metadata "$DATA_DEVICE" 2>>"$LOG" | python3 -c '
import json, sys
meta = json.load(sys.stdin)
tokens = meta.get("tokens") or {}
ours = [t for t in tokens.values() if isinstance(t, dict) and t.get("type") == sys.argv[1]]
if len(ours) != 1:
    sys.exit(1)
identity = ours[0].get("identity_b64")
if not isinstance(identity, str) or not identity:
    sys.exit(1)
print(identity)
' "$DISK_TOKEN_TYPE"
}

open_data_mapper() {
  if [[ -b "$DATA_MAPPER" ]]; then
    log "Encrypted data disk is already open at $DATA_MAPPER"
  else
    cryptsetup open --type luks2 --key-file "$DISK_KEY_FILE" "$DATA_DEVICE" "$DATA_MAPPER_NAME" >>"$LOG" 2>&1 \
      || fatal "could not open the encrypted data disk $DATA_DEVICE with the KMS key. \
Either the KMS released a different key (a different identity or release \
profile) or the header was tampered with. Not formatting it -- see $LOG."
  fi
  # The key has done its job. Shred it now rather than at exit.
  disk_secrets_cleanup
}

# FIRST BOOT: the device is blank. Mint an identity, get its key, and build the
# encrypted volume. The token is written and read back BEFORE any data goes on
# the volume, so a disk holding anything is always one this node can reopen.
#
# `luksFormat --integrity` WIPES THE WHOLE DEVICE to initialise the integrity
# tags, and that is deliberate even though it makes the first boot slow (the
# wipe runs at the disk's write throughput: minutes to tens of minutes for
# 200 GB depending on the disk type). `--integrity-no-wipe` would skip it, but
# then every never-written sector fails its integrity check when read, and
# "never written" includes whatever the page cache or ext4 decides to read
# around a partial write -- the cryptsetup man page warns that even writes can
# then fail. An I/O error surfacing weeks later under merod is a far worse
# failure than a slow first boot, and the release pipeline's measurement VM
# never gets here (it uses the ephemeral tmpfs), so the cost lands only on real
# nodes, once.
#
# If the boot is interrupted during the wipe, the device is left with a LUKS2
# header and no token. The next boot refuses it (below) instead of reformatting:
# on the first boot there is nothing to lose, but code that reformats "a LUKS
# device without our token" is code that can wipe a real disk. Recreate the node.
WIPE_PROGRESS_SECS=30

# Turns cryptsetup's `--progress-json` lines into one journal line each:
#   Integrity wipe: 42% (84 of 200 GB, 3m20s left)
# Reads until cryptsetup closes stdout; a pipeline under `pipefail` still
# reports luksFormat's own exit status.
log_wipe_progress() {
  local line done_b size_b eta_ms
  local re='"device_bytes":"([0-9]+)".*"device_size":"([0-9]+)".*"eta_ms":"([0-9]+)"'
  while IFS= read -r line; do
    if [[ "$line" =~ $re ]]; then
      done_b="${BASH_REMATCH[1]}" size_b="${BASH_REMATCH[2]}" eta_ms="${BASH_REMATCH[3]}"
      (( size_b > 0 )) || continue
      log "Integrity wipe: $(( done_b * 100 / size_b ))% ($(( done_b / 1000000000 )) of \
$(( size_b / 1000000000 )) GB, $(( eta_ms / 60000 ))m$(( eta_ms / 1000 % 60 ))s left)"
    elif [[ -n "$line" ]]; then
      echo "$line" >>"$LOG"
    fi
  done
}

format_encrypted_data_disk() {
  log "Data disk is blank; creating an encrypted LUKS2 volume (aes-xts-plain64, \
hmac-sha256 integrity) keyed from the KMS. The integrity wipe covers the whole \
device and can take a long time on the first boot."
  prepare_disk_key_dir
  rm -f "$DISK_IDENTITY_FILE"
  fetch_disk_key create
  [[ -s "$DISK_IDENTITY_FILE" ]] || fatal "merod kms disk-key did not create the disk identity"

  # Re-probe immediately before formatting. Nothing else should have touched
  # the device in between, and if something did, it is no longer blank.
  local rc=0
  probe_signature "$DATA_DEVICE" >/dev/null || rc=$?
  [[ "$rc" == 2 ]] || fatal "$DATA_DEVICE is no longer blank (blkid rc=$rc); not formatting it"

  modprobe dm_crypt 2>/dev/null || true
  modprobe dm_integrity 2>/dev/null || true
  # The wipe prints nothing for minutes, and a silent journal reads as a hung
  # node. `--batch-mode` turns cryptsetup's text progress off, but not its JSON
  # progress: one line every WIPE_PROGRESS_SECS, logged here as a percentage.
  # stderr goes to $LOG as before; any other stdout line is kept there too.
  cryptsetup luksFormat --type luks2 \
      --cipher aes-xts-plain64 --key-size 512 \
      --integrity hmac-sha256 \
      --pbkdf pbkdf2 --pbkdf-force-iterations 1000 \
      --progress-json --progress-frequency "$WIPE_PROGRESS_SECS" \
      --batch-mode --key-file "$DISK_KEY_FILE" \
      "$DATA_DEVICE" 2>>"$LOG" | log_wipe_progress \
    || fatal "cryptsetup luksFormat failed on $DATA_DEVICE; see $LOG"

  local identity_b64 token_json
  identity_b64="$(base64 -w0 < "$DISK_IDENTITY_FILE")"
  token_json="$(python3 -c '
import json, sys
print(json.dumps({
    "type": sys.argv[1],
    "keyslots": [],
    "identity_b64": sys.argv[2],
    "kms_release": sys.argv[3],
}))
' "$DISK_TOKEN_TYPE" "$identity_b64" "${SANITIZED_TEE_RELEASE_VERSION:-}")"
  printf '%s' "$token_json" | cryptsetup token import "$DATA_DEVICE" >>"$LOG" 2>&1 \
    || fatal "could not store the disk identity in the LUKS2 header of $DATA_DEVICE"
  # Read it back: a volume that cannot be reopened must never receive data.
  [[ "$(read_disk_token_identity || true)" == "$identity_b64" ]] \
    || fatal "the disk identity read back from $DATA_DEVICE does not match what was written"
  log "Stored the data-disk identity in the LUKS2 header (token type $DISK_TOKEN_TYPE)"

  open_data_mapper
  mkfs.ext4 -q "$DATA_MAPPER" >>"$LOG" 2>&1 || fatal "mkfs.ext4 failed on $DATA_MAPPER"
  log "Created ext4 on the encrypted data disk"
}

# EVERY LATER BOOT: open the volume with the key for the identity in its header.
unlock_encrypted_data_disk() {
  log "Data disk is LUKS-encrypted; fetching its key from the KMS"
  prepare_disk_key_dir
  local identity_b64
  identity_b64="$(read_disk_token_identity)" || fatal "$DATA_DEVICE is a LUKS \
device without exactly one $DISK_TOKEN_TYPE token, so this node cannot know which \
identity unlocks it. That is what a first boot interrupted during the format \
leaves behind. Refusing to touch it -- recreate the node."
  ( umask 077; printf '%s' "$identity_b64" | base64 -d > "$DISK_IDENTITY_FILE" ) \
    || fatal "the disk identity token on $DATA_DEVICE is not valid base64"
  fetch_disk_key
  open_data_mapper
}

# Mount the opened volume, refusing anything but the filesystem this script
# created. A blank or foreign mapping is NOT formatted: the only way to get
# one is an interrupted first boot or tampering, and a read error must never
# be mistaken for "empty".
mount_encrypted_data_disk() {
  local rc=0 sig
  sig="$(probe_signature "$DATA_MAPPER")" || rc=$?
  if [[ "$rc" != 0 || "$sig" != ext4 ]]; then
    fatal "the encrypted data disk opened but holds '${sig:-nothing}' (blkid rc=$rc), \
not the ext4 this node creates. Not formatting it: that is an interrupted first \
boot or tampering. Recreate the node."
  fi
  mount -t ext4 -o nosuid,nodev "$DATA_MAPPER" "$DATA_MOUNT" >>"$LOG" 2>&1 \
    || fatal "$DATA_MAPPER could not be mounted at $DATA_MOUNT; see $LOG"
  DATA_DISK_STATE="encrypted"
  log "Mounted the encrypted data disk at $DATA_MOUNT ($(df -h --output=size "$DATA_MOUNT" 2>/dev/null | tail -1 | tr -d ' '))"
}

# The encryption decision for a BLANK disk, mirroring the store's below: a KMS
# with no release to verify it against is refused on every profile;
# locked-read-only never creates a plaintext disk; the debug profiles do, and
# say so. Sets BLANK_DISK_PLAN to `encrypt` or `plain`.
#
# A global rather than printed, and called directly rather than in `$(...)`:
# in a command substitution `fatal` would exit only the subshell, the caller
# would compare an empty string, and the boot would fall through to the
# PLAINTEXT branch -- the exact failure this decision exists to prevent. (`log`
# also writes to stdout, which a substitution would capture as the answer.)
BLANK_DISK_PLAN=""
blank_disk_plan() {
  BLANK_DISK_PLAN=
  if [[ -n "$KMS_URL" ]]; then
    [[ -n "${TEE_RELEASE_VERSION:-}" ]] || fatal "kms-url is set but \
tee-release-version is not. The KMS is verified against that release's signed \
policy, and without it merod cannot tell a real KMS from an impostor. Refusing \
to create the data disk."
    if merod_can_unlock_disk && command -v cryptsetup >/dev/null 2>&1; then
      BLANK_DISK_PLAN=encrypt
      return 0
    fi
    if [[ "$IMAGE_PROFILE" == "locked-read-only" ]]; then
      fatal "this image cannot encrypt the data disk (the baked merod has no \
'kms disk-key', or cryptsetup is missing). Refusing to create an unencrypted data \
disk on the locked-read-only profile. Bump merodVersion in versions.json."
    fi
    log "WARN: this image cannot encrypt the data disk (no 'merod kms disk-key' or \
no cryptsetup); creating an UNENCRYPTED one (allowed on profile=$IMAGE_PROFILE only)."
    BLANK_DISK_PLAN=plain
    return 0
  fi
  if [[ "$IMAGE_PROFILE" == "locked-read-only" ]]; then
    fatal "no kms-url metadata. The locked-read-only profile does not create \
an unencrypted data disk: the node's TLS key, config and fleet credentials would \
sit in plaintext on a disk the host can read. Set kms-url (and \
tee-release-version) on the instance."
  fi
  log "WARN: no kms-url metadata; creating an UNENCRYPTED data disk (allowed \
on profile=$IMAGE_PROFILE only)."
  BLANK_DISK_PLAN=plain
}

# The old behaviour, for a plain ext4 disk: mount it, and record it in fstab so
# a reboot does not depend on this script. Used for a node created before disk
# encryption, and for a debug node created without a KMS.
mount_plain_data_disk() {
  if mount "$DATA_DEVICE" "$DATA_MOUNT" >>"$LOG" 2>&1; then
    DATA_DISK_STATE="plaintext"
    log "Mounted $DATA_DEVICE at $DATA_MOUNT ($(df -h --output=size "$DATA_MOUNT" 2>/dev/null | tail -1 | tr -d ' '))"
    # Survive a reboot without depending on this script running first.
    # `nofail` so a missing disk degrades to the warning above rather than
    # dropping the boot into emergency mode, which on a shell-less machine is
    # indistinguishable from a brick.
    DATA_UUID="$(blkid -o value -s UUID "$DATA_DEVICE" 2>/dev/null || true)"
    if [[ -n "$DATA_UUID" ]] && ! grep -q "$DATA_UUID" /etc/fstab 2>/dev/null; then
      printf 'UUID=%s %s ext4 defaults,nofail 0 2\n' "$DATA_UUID" "$DATA_MOUNT" >> /etc/fstab
      log "Recorded the data disk in /etc/fstab"
    fi
  else
    # The disk is THERE and will not mount. Refusing to continue is the whole
    # point: the alternative is writing the node's state to root and finding
    # out when root fills. calimero-init's journal ships now, so a node that
    # stops here says why.
    log "ERROR: $DATA_DEVICE exists but could not be mounted at $DATA_MOUNT. \
Refusing to initialise onto the root filesystem -- see $LOG."
    exit 1
  fi
}

warn_plaintext_data_disk() {
  log "WARN: the data disk is UNENCRYPTED ext4 (created before full-disk \
encryption, or on a debug profile without a KMS). Its TLS key, merod config, \
mero-auth database and fleet credentials are readable by anyone who can \
snapshot it. It is mounted as before and NOT reformatted. Recreate this node to \
get an encrypted data disk."
}

mkdir -p "$DATA_MOUNT"

if [[ "$EPHEMERAL_STORE" == true ]]; then
  # A tmpfs lives in guest memory, which TDX encrypts, so nothing merod writes
  # reaches a disk the host can read. Everything is gone at power-off: the node
  # comes back as a fresh identity, which is what a VM meant to live minutes
  # wants. The data disk (if any) is left untouched.
  DATA_DISK_STATE="ephemeral"
  if [[ "$(findmnt -n -o FSTYPE "$DATA_MOUNT" 2>/dev/null)" == tmpfs ]]; then
    log "Ephemeral store: tmpfs already mounted at $DATA_MOUNT"
  elif mount -t tmpfs -o mode=0755,size=50% tmpfs "$DATA_MOUNT" >>"$LOG" 2>&1; then
    log "Ephemeral store: mounted a tmpfs at $DATA_MOUNT; this node's state is in memory only and does not survive a reboot"
  else
    log "ERROR: ephemeral-store is set but a tmpfs could not be mounted at $DATA_MOUNT. Refusing to continue."
    exit 1
  fi
elif mountpoint -q "$DATA_MOUNT"; then
  # Mounted before this script ran: a plain disk from its fstab entry, or this
  # script running a second time in one boot.
  if [[ "$(findmnt -n -o SOURCE "$DATA_MOUNT" 2>/dev/null)" == "$DATA_MAPPER" ]]; then
    DATA_DISK_STATE="encrypted"
    log "Encrypted data disk already mounted at $DATA_MOUNT"
  else
    DATA_DISK_STATE="plaintext"
    log "Data disk already mounted at $DATA_MOUNT"
    warn_plaintext_data_disk
  fi
elif [[ -n "$(ls -A "$DATA_MOUNT" 2>/dev/null)" ]]; then
  # A NODE THAT PREDATES THIS CHANGE. Its state is already sitting on the root
  # filesystem under this path. Mounting the (empty) disk over it would hide
  # that state, merod would find no node and initialise a fresh one, and the
  # node would silently lose its identity -- peer id, account, keys.
  #
  # So: refuse, and say so. The node keeps working exactly as it did. Instance
  # metadata is written at creation and never backfilled, so such a node has to
  # be recreated for other reasons anyway; this is one more.
  DATA_DISK_STATE="root-legacy"
  log "WARN: $DATA_MOUNT holds data but is NOT a mount point, so this node's \
state is on the root filesystem. Not mounting the data disk over it -- that \
would hide the existing state and merod would initialise a fresh identity. \
This node has ~$(df -BG --output=avail / 2>/dev/null | tail -1 | tr -d ' G')G \
of usable space, not the provisioned disk size, and its state is UNENCRYPTED on \
the boot disk. Recreate the node to move onto an encrypted data disk."
else
  # Wait for the device, and find it even where udev never names it.
  #
  # mdma creates the VM with the disk attached as deviceName "data", which GCE's
  # udev rule (65-gce-disk-naming.rules, via google_nvme_id on NVMe) links as
  # /dev/disk/by-id/google-data. On the first 2.3.80 nodes that link never
  # appeared although GCP listed the disk as attached from creation, and a
  # locked image has no shell or kernel console to say why: the image shipped
  # neither half of that rule (2.3.86 logged MISSING for both), and now vendors
  # them (roles/merotee/files/gce-udev). So where the link is still missing,
  # fall back to the ONE whole disk that has nothing on it the
  # kernel knows of: no partitions, no holders, not read-only, not mounted. The
  # boot disk is partitioned and never qualifies. Two candidates is a guess, and
  # this never guesses: it takes none. Picking by structure, not by NVMe
  # enumeration order, is what keeps /dev/nvme0n2 out of this script.
  #
  # Nothing is trusted more for having been found this way. The link itself is
  # derived from metadata the host supplies, and what the disk holds is decided
  # below by `blkid -p` and the KMS-keyed LUKS header, never by its name.
  find_unnamed_data_disk() {
    # A count, not an array length: the brace-hash spelling opens a Jinja comment.
    local disk type ro found="" count=0
    while read -r disk type ro; do
      [[ "$type" == "disk" && "$ro" == "0" ]] || continue
      [[ "$disk" == /dev/loop* || "$disk" == /dev/ram* || "$disk" == /dev/zram* ]] && continue
      # Any child (a partition, a dm/crypt holder) means the disk is in use.
      [[ "$(lsblk -nrpo NAME "$disk" 2>/dev/null | wc -l)" == 1 ]] || continue
      findmnt -rn -S "$disk" >/dev/null 2>&1 && continue
      found="$disk"
      count=$((count + 1))
    done < <(lsblk -dnrpo NAME,TYPE,RO 2>/dev/null)
    (( count == 1 )) || return 1
    printf '%s' "$found"
  }

  # What the guest sees, for the journal: the only account a locked node can
  # give of a disk it could not find.
  log_block_devices() {
    log "Block devices: $(lsblk -o NAME,SIZE,TYPE,RO,MODEL,SERIAL 2>&1 | tr '\n' ';')"
    local by_id
    by_id="$(dirname "$DATA_DEVICE_LINK")"
    log "${by_id}: $(ls -1 "$by_id" 2>&1 | tr '\n' ' ')"
    local f
    for f in /usr/lib/udev/rules.d/65-gce-disk-naming.rules /usr/lib/udev/google_nvme_id; do
      [[ -e "$f" ]] && log "present: $f" || log "MISSING: $f"
    done
    # What this boot's root is, and what the rule directory holds. The build
    # proves both files are in the sealed image, so a MISSING above with these
    # says whether the boot mounted a different root or something hides them.
    log "root: $(findmnt -no SOURCE,FSTYPE,OPTIONS / 2>&1 | tr '\n' ' ')"
    log "/usr/lib/udev/rules.d: $(ls -1 /usr/lib/udev/rules.d 2>&1 | grep -iE 'gce|google|nvme|disk' | tr '\n' ' ')"
    log "nvme: $(command -v nvme || echo 'not installed')"
  }

  # Where a missing disk is fatal anyway (locked-read-only keeps state nowhere
  # else, and a KMS-backed store needs the encrypted disk), wait long. Elsewhere
  # a missing disk is a legitimate shape, so keep it short.
  DATA_DEVICE_WAIT_SECS=30
  if [[ "$IMAGE_PROFILE" == "locked-read-only" || -n "$KMS_URL" ]]; then
    DATA_DEVICE_WAIT_SECS=600
  fi
  # udev names the disk within a second or two of boot when it names it at
  # all; give it that long before accepting a disk it did not name.
  DATA_DEVICE_NAMING_GRACE_SECS=10
  DATA_DEVICE_LINK="$DATA_DEVICE"
  waited=0
  while [[ ! -b "$DATA_DEVICE" && "$waited" -lt "$DATA_DEVICE_WAIT_SECS" ]]; do
    if (( waited >= DATA_DEVICE_NAMING_GRACE_SECS )) && fallback="$(find_unnamed_data_disk)"; then
      log "WARN: $DATA_DEVICE was never created; using $fallback, the only unused whole disk"
      log_block_devices
      DATA_DEVICE="$fallback"
      break
    fi
    sleep 1
    waited=$((waited + 1))
    if (( waited % 30 == 0 )); then
      log "Waiting for the data disk at $DATA_DEVICE (${waited}s of ${DATA_DEVICE_WAIT_SECS}s)"
    fi
  done

  if [[ ! -b "$DATA_DEVICE" ]]; then
    log_block_devices
    # No data disk at all. A legitimate shape for a deployment that provisions
    # none, so this is not fatal -- but it is never what an mdma-created node
    # should look like, and the capacity it reports will be the root disk's.
    log "WARN: no data disk at $DATA_DEVICE after ${DATA_DEVICE_WAIT_SECS}s; $CALIMERO_HOME will live \
on the root filesystem. This is expected only where no data disk is provisioned."
  else
    # Never reformat: on any boot after the first, this device holds the node's
    # entire state, and a reformat here would be indistinguishable from a wipe.
    # So the decision keys on what `blkid -p` finds, and only its explicit
    # "nothing here" (rc 2) counts as blank. A probe that FAILED is not blank.
    DATA_SIG_RC=0
    DATA_SIG="$(probe_signature "$DATA_DEVICE")" || DATA_SIG_RC=$?
    if [[ "$DATA_SIG_RC" == 2 ]]; then
      blank_disk_plan
      if [[ "$BLANK_DISK_PLAN" == encrypt ]]; then
        format_encrypted_data_disk
        mount_encrypted_data_disk
      elif [[ "$BLANK_DISK_PLAN" == plain ]]; then
        log "Data disk is unformatted; creating ext4 on $DATA_DEVICE"
        mkfs.ext4 -q -F "$DATA_DEVICE" >>"$LOG" 2>&1 || log "WARN: mkfs.ext4 failed on $DATA_DEVICE"
        mount_plain_data_disk
        warn_plaintext_data_disk
      else
        fatal "no decision was reached for the blank data disk; refusing to format it"
      fi
    elif [[ "$DATA_SIG_RC" != 0 ]]; then
      fatal "could not probe $DATA_DEVICE (blkid rc=$DATA_SIG_RC). Not formatting \
or mounting a device whose contents are unknown."
    elif [[ "$DATA_SIG" == crypto_LUKS ]]; then
      command -v cryptsetup >/dev/null 2>&1 \
        || fatal "$DATA_DEVICE is LUKS-encrypted but cryptsetup is not installed"
      merod_can_unlock_disk \
        || fatal "$DATA_DEVICE is LUKS-encrypted but the baked merod has no 'kms disk-key' to unlock it"
      [[ -n "$KMS_URL" ]] \
        || fatal "$DATA_DEVICE is LUKS-encrypted but kms-url is not set, so its key cannot be fetched"
      [[ -n "${TEE_RELEASE_VERSION:-}" ]] \
        || fatal "$DATA_DEVICE is LUKS-encrypted but tee-release-version is not set, \
so the KMS its key comes from could not be verified. Refusing to start."
      unlock_encrypted_data_disk
      mount_encrypted_data_disk
    elif [[ "$DATA_SIG" == ext4 ]]; then
      # A node from before disk encryption. Mounted exactly as before: this is
      # its whole state, and "encrypting" it would mean formatting it.
      mount_plain_data_disk
      warn_plaintext_data_disk
    else
      fatal "$DATA_DEVICE holds '$DATA_SIG', which this image never creates. \
Refusing to format or mount it -- it may be someone's data. Detach it or recreate \
the node with a blank data disk."
    fi
  fi
fi

# Boot-time conformance for the disk: an "encrypted" disk must really be the
# dm-crypt mapping, LUKS2, with integrity. Cheap, and it turns a regression in
# the logic above into a refused boot instead of a plaintext node.
if [[ "$DATA_DISK_STATE" == encrypted ]]; then
  [[ "$(findmnt -n -o SOURCE "$DATA_MOUNT" 2>/dev/null)" == "$DATA_MAPPER" ]] \
    || fatal "$DATA_MOUNT is not backed by $DATA_MAPPER"
  DATA_CRYPT_STATUS="$(cryptsetup status "$DATA_MAPPER_NAME" 2>/dev/null || true)"
  grep -qE '^[[:space:]]*type:[[:space:]]+LUKS2' <<<"$DATA_CRYPT_STATUS" \
    || fatal "$DATA_MAPPER_NAME is not a LUKS2 mapping"
  grep -qE '^[[:space:]]*integrity:[[:space:]]+[a-z]' <<<"$DATA_CRYPT_STATUS" \
    || fatal "$DATA_MAPPER_NAME has no integrity protection"
  log "Data disk check: $DATA_MOUNT is a LUKS2 dm-crypt mapping with integrity"
fi

# On locked-read-only, a node's state lives in TDX memory or on the encrypted
# disk -- nowhere else. Anything else is state the HOST could have written, and
# that is not just a confidentiality leak: a plain disk the operator prepared can
# carry a node identity (config.toml's libp2p key) the operator also holds. A
# genuine TD would attest under that key, be admitted as a TEE member
# (`ReadOnlyTee` or `RelayTee`), and be handed group keys wrapped to an identity
# the operator can unwrap. An encrypted disk cannot be prepared that way: its
# contents are sealed under a key only a genuine TD obtains, so nothing on it
# was written by anyone else.
#
# Existing nodes are not affected: the image is their boot disk, so a node on an
# older image keeps it. Only a NEW VM boots this image, and mdma gives it a blank
# data disk -- a plain one here is a disk someone attached.
if [[ "$IMAGE_PROFILE" == locked-read-only ]] \
  && [[ "$DATA_DISK_STATE" != encrypted ]] && [[ "$DATA_DISK_STATE" != ephemeral ]]; then
  fatal "locked-read-only keeps node state only on an encrypted data disk or in \
memory, and this node's would be '${DATA_DISK_STATE:-unset}' (host-writable). \
Refusing to start: state the host can write can carry an identity the host holds. \
Recreate the node with a blank data disk."
fi

# --- Fleet state off the boot disk -------------------------------------------
#
# The fleet sidecar used to keep its state -- including `fleet-token`, the
# credential mdma issues on attested registration -- under /var/lib/calimero,
# on the boot disk, which is as host-readable as any other. It now keeps it on
# the data disk (/mnt/data/fleet), which is encrypted above and is mounted
# before the sidecar can start (the unit Requires= this one). The token has to
# survive reboots (re-registering costs a quote and a challenge), so /run would
# not do; the data disk is the one persistent place the host cannot read.
#
# Moved once, here, because this runs after the mount and before the sidecar.
# Copy-then-shred rather than `mv`: across filesystems `mv` is a copy and an
# unlink, and an unlink leaves the blocks behind. shred is best effort on
# SSD-backed ext4; a node that held a token on its boot disk should rotate it by
# re-registering, which recreating the node does.
FLEET_STATE_DIR="$DATA_MOUNT/fleet"
LEGACY_FLEET_STATE_DIR="/var/lib/calimero"
mkdir -p "$FLEET_STATE_DIR"
chmod 0700 "$FLEET_STATE_DIR"
if [[ -d "$LEGACY_FLEET_STATE_DIR" ]]; then
  for legacy in "$LEGACY_FLEET_STATE_DIR"/fleet-*; do
    [[ -f "$legacy" ]] || continue
    dest="$FLEET_STATE_DIR/$(basename "$legacy")"
    if [[ ! -e "$dest" ]]; then
      cp -p "$legacy" "$dest" || { log "WARN: could not move $legacy to $FLEET_STATE_DIR"; continue; }
    fi
    shred -u "$legacy" 2>/dev/null || rm -f "$legacy"
  done
  rmdir "$LEGACY_FLEET_STATE_DIR" 2>/dev/null || true
  log "Moved fleet sidecar state from $LEGACY_FLEET_STATE_DIR to $FLEET_STATE_DIR"
fi

# --- Storage encryption (KMS) ------------------------------------------------
#
# TDX protects this VM's MEMORY. It does not protect its disks: the data disk
# is a device the host reads and writes, so whatever merod stores in plaintext
# is readable by anyone who can snapshot or attach that disk -- the cloud
# project, or whoever compromises it. A new node's data disk is now encrypted
# as a whole (above); the store keeps its own KMS key as well, because the two
# fail differently: a node created before disk encryption, or a debug node with
# a plain disk, still gets an encrypted store, and an encrypted store never
# depends on the disk-unlock path being right. merod's store holds
# the node's signing identity (the key it was ADMITTED under as a TEE member),
# its account root, and every context's replicated state. A copied disk is
# therefore a copy of an admitted fleet member: it can pull every group key the
# node was given, and, since admitted TEEs may vouch for new ones, admit more.
#
# So the store is encrypted with a key released by mero-kms, which only
# hands it to a TD whose quote matches the release policy and is bound to this
# node's peer id. The key is derived from `{namespace}/{profile}/{peerId}`, so
# it survives image upgrades within a profile.
#
# It has to happen at `merod init`, not later. `init` is what writes the signing
# identity and account root, so a store encrypted only from the first `run`
# would already hold both in plaintext -- and could not be opened encrypted at
# all, because every read decrypts. `merod init --kms-url` fetches the key
# before writing anything and saves `[tee.kms]` so `run` fetches the same
# key on every boot.
#
# `tee-release-version` names the signed mero-tee release whose policy the KMS
# is verified against; `merod init --kms-url` refuses without it, because a key
# from an unverified KMS may be known to whoever runs the endpoint.
#
# Keyed on config.toml, not the node directory: config.toml is what marks a
# node initialised, and `merod init --kms-url` fetches the key before writing
# it, so an init that failed on an unreachable or unverifiable KMS is retried on
# the next boot instead of being mistaken for a finished node.
NODE_CONFIG="$CALIMERO_HOME/$CALIMERO_NODE/config.toml"

merod_can_encrypt_at_init() {
  "$BIN_DIR/merod" --node probe init --help 2>/dev/null | grep -q -- '--kms-url'
}

# The one case where locked-read-only may create a node with no KMS: the store
# is on a tmpfs and nothing can page it out, so it only ever exists in memory
# TDX encrypts. Checked from the mount table rather than taken from the
# `ephemeral-store` metadata, so a host that sets that key on a normal node
# gets a node whose state vanishes at reboot, never a plaintext disk.
store_is_memory_only() {
  [[ "$(findmnt -n -o FSTYPE --target "$CALIMERO_HOME" 2>/dev/null)" == tmpfs ]] \
    && [[ -z "$(swapon --noheadings 2>/dev/null)" ]]
}

# MERO_TEE_VERSION (and the floor and profile pin) were exported under
# "Release pinning" above, for `merod init` as much as for the disk key.

mkdir -p "$CALIMERO_HOME"
if [[ ! -f "$NODE_CONFIG" ]]; then
  if [[ -n "$KMS_URL" ]]; then
    [[ -n "${TEE_RELEASE_VERSION:-}" ]] || fatal "kms-url is set but \
tee-release-version is not. The KMS is verified against that release's signed \
policy, and without it merod cannot tell a real KMS from an impostor. Refusing \
to initialise."
    if merod_can_encrypt_at_init; then
      INIT_EXTRA_ARGS=(--kms-url "$KMS_URL")
      INIT_ENCRYPTED=true
      log "Initializing Calimero node with a KMS-encrypted store (kms=$KMS_URL release=$TEE_RELEASE_VERSION)..."
    elif [[ "$IMAGE_PROFILE" == "locked-read-only" ]]; then
      fatal "the baked merod does not support 'init --kms-url', so it cannot \
create an encrypted store. Refusing to create an unencrypted node on the \
locked-read-only profile. Bump merodVersion in versions.json."
    else
      log "WARN: the baked merod does not support 'init --kms-url'; creating an \
UNENCRYPTED store (allowed on profile=$IMAGE_PROFILE only)."
    fi
  elif store_is_memory_only; then
    log "No kms-url metadata; the store is on a tmpfs with no swap, so it \
exists only in TDX-encrypted memory. Initialising without a KMS (profile=$IMAGE_PROFILE)."
  elif [[ "$IMAGE_PROFILE" == "locked-read-only" ]]; then
    fatal "no kms-url metadata. The locked-read-only profile does not \
create a node with an unencrypted store: its signing identity would sit in \
plaintext on a disk the host can read. Set kms-url (and \
tee-release-version) on the instance."
  else
    log "WARN: no kms-url metadata; creating an UNENCRYPTED store (allowed \
on profile=$IMAGE_PROFILE only)."
  fi
  # A flag rather than bash's array-length form: this file is a Jinja
  # template, and that form opens with Jinja's comment delimiter, which fails
  # the render mid-image-build.
  if [[ "$INIT_ENCRYPTED" != true ]]; then
    log "Initializing Calimero node..."
  fi
  # Under `set -e` a failed init stops here, before any service starts: no
  # plaintext fallback, and config.toml is absent so the next boot retries.
  init_node
elif grep -q '^\[tee' "$NODE_CONFIG"; then
  log "Calimero node already initialized at $CALIMERO_HOME/$CALIMERO_NODE with a KMS-encrypted store; skipping init"
  if [[ "$IMAGE_PROFILE" == "locked-read-only" && -z "${TEE_RELEASE_VERSION:-}" ]]; then
    fatal "this node's store is KMS-encrypted but tee-release-version is \
missing, so merod would accept its key from an unverified KMS. Refusing to \
start."
  fi
else
  # A node initialised before this change. Its store is plaintext and cannot be
  # encrypted in place (every read would fail to decrypt), and its keys have
  # been on a host-readable disk for as long as it has run -- encrypting now
  # would not un-expose them. It keeps running so the fleet does not lose
  # capacity on an image upgrade; the remedy is to recreate it.
  log "WARN: Calimero node at $CALIMERO_HOME/$CALIMERO_NODE has an UNENCRYPTED \
store (initialised before KMS storage encryption). Its signing identity and \
account root are readable from the data disk and must be treated as exposed. \
Recreate this node to move it onto an encrypted store."
fi

if [[ "$MEROD_MODE" == "read-only" ]]; then
  log "Applying read-only merod config (jsonrpc/sse/websocket disabled)..."
  "$BIN_DIR/merod" --home "$CALIMERO_HOME" --node "$CALIMERO_NODE" config \
    'server.jsonrpc.enabled=false' \
    'server.sse.enabled=false' \
    'server.websocket.enabled=false' \
    || log "WARN: failed to apply read-only merod config"
fi

{% if fleet_delegated_access | default(false) | bool %}
# Delegated execution: serve `GET`/`POST /admin-api/contexts/<ctx>/intents`
# (and, on a merod that has it, `GET`/`POST
# /admin-api/groups/<group>/context-intents` for delegated context creation)
# without a node credential, so a keyholder that has no account here can still
# have this node write on their behalf.
#
# The pair to the `node-api-intents` and `node-api-context-intents` routers in
# traefik's routing.yml, set from the same `fleet_delegated_access` variable so
# the edges cannot drift. Only those routes are opened, and all are
# self-authenticating (a creation warrant is checked against the AUTHOR's
# `CAN_CREATE_CONTEXT`, the rest as below): merod
# refuses an intent unless the warrant is the member's, commits to this exact
# method and arguments, is unexpired, has an unspent nonce, and this node is a
# `RelayTee` in the owning group (a `ReadOnlyTee` is refused with a 403).
#
# Non-fatal on failure, deliberately: a node that cannot apply this is a node
# that replicates but does not relay, which is a degraded fleet member rather
# than a broken one. The `authorship_ready` the sidecar reports to mdma is what
# keeps clients from being sent to it — mdma only advertises a relay the node
# itself confirmed can write.
# The CURRENT key spelling, `server.admin.delegated_access`.
#
# Core renamed `public_intents` to `delegated_access` in 0.11.0-rc.43 and kept
# the old spelling as a serde alias. This used to write the old spelling, so an
# image could pair with a merod from before the rename. That now breaks every
# node: `merod init` writes `delegated_access = false`, adding `public_intents`
# beside it is the same field twice, and merod refuses the whole config.toml
# ("duplicate field `delegated_access`"). The first 2.3.86 nodes booted and
# registered but never relayed. The image bakes its own merod, and
# `merodVersion` is far past the rename, which the build asserts (the
# `--delegated-access` help probe in tasks/main.yml).
log "Enabling delegated access on the admin API..."
"$BIN_DIR/merod" --home "$CALIMERO_HOME" --node "$CALIMERO_NODE" config \
  'server.admin.delegated_access=true' \
  || log "WARN: failed to enable delegated access; this node will replicate but not relay"

# Who a device-key session belongs to. merod runs in proxy auth mode, so it
# installs no guard of its own and, without this, sees every caller as
# anonymous: the caller-scoped listings answer node-wide and `POST .../query`
# refuses. With it, merod takes the account and device from the
# `X-Auth-Account` / `X-Auth-Device` headers that traefik's `auth-node` copies
# from mero-auth, and scopes each tenant to its own groups.
#
# Safe here because traefik is the only way in: it replaces those two headers on
# every route `auth-node` guards and strips them on every other route
# (`strip-proxy-identity` on both entrypoints), and merod listens on loopback.
#
# FATAL on failure, unlike the key above. A relay whose mero-auth has
# device-key login on (`mero-auth-start`) but whose merod ignores the caller's
# identity would list every tenant's contexts to any one of them. Refusing to
# start is the failure that cannot leak.
log "Taking device-key callers' identity from the proxy..."
"$BIN_DIR/merod" --home "$CALIMERO_HOME" --node "$CALIMERO_NODE" config \
  'server.proxy_identity=true' \
  || fatal "failed to set server.proxy_identity; refusing to serve device-key sessions node-wide"
{% endif %}

# TLS material for traefik.
#
# The key is generated HERE, inside the enclave, and never leaves it: the fleet
# sidecar builds a CSR from it and mdma returns only a signed certificate. So no
# private key for a publicly-trusted certificate ever crosses the wire, and mdma
# stores none.
#
# The self-signed placeholder exists so traefik's TLS store always loads. Its
# `defaultCertificate` names a fixed path (see traefik-routing.yml), and this
# runs before traefik starts. Until mdma issues the real chain the node serves
# :80 as it always did and :443 with an untrusted certificate that nothing is
# pointed at -- mdma advertises no relay URL for a node whose certificate has
# not been issued, so no client is ever sent to it.
#
# Both files are left alone once present: the key is the node's long-lived TLS
# identity, and cert.pem is whatever the sidecar last installed. Regenerating
# either on a reboot would invalidate the certificate issued for this key.
TLS_DIR="/mnt/data/tls"
mkdir -p "$TLS_DIR"
chmod 0700 "$TLS_DIR"
if [[ ! -s "$TLS_DIR/key.pem" ]]; then
  log "Generating node TLS key (stays in the enclave; only a CSR ever leaves)"
  if openssl req -x509 -newkey ec -pkeyopt ec_paramgen_curve:prime256v1 -nodes \
      -keyout "$TLS_DIR/key.pem" -out "$TLS_DIR/cert.pem" -days 3650 \
      -subj "/CN=calimero-fleet-node" >>"$LOG" 2>&1; then
    chmod 0600 "$TLS_DIR/key.pem"
    chmod 0644 "$TLS_DIR/cert.pem"
  else
    log "WARN: TLS key generation failed; traefik will fall back to its own self-signed default"
  fi
elif [[ ! -s "$TLS_DIR/cert.pem" ]]; then
  # Key survived but the certificate did not (an interrupted install). Put a
  # placeholder back so the TLS store still loads; the sidecar reinstalls.
  log "TLS key present but certificate missing; regenerating placeholder"
  openssl req -x509 -new -nodes -key "$TLS_DIR/key.pem" -out "$TLS_DIR/cert.pem" \
    -days 3650 -subj "/CN=calimero-fleet-node" >>"$LOG" 2>&1 \
    || log "WARN: placeholder certificate regeneration failed"
  chmod 0644 "$TLS_DIR/cert.pem"
fi

log "Starting services..."
systemctl daemon-reload
systemctl enable merod mero-auth traefik
# Start non-blocking to avoid deadlock with units that declare After=calimero-init.service.
systemctl start --no-block merod mero-auth traefik
log "Queued non-blocking start for merod, mero-auth, and traefik"

if [[ "$MEROD_MODE" == "read-only" ]] && systemctl list-unit-files fleet-sidecar.service >/dev/null 2>&1; then
  systemctl start --no-block fleet-sidecar
  log "Queued non-blocking start for fleet-sidecar"
fi

log "Calimero init completed"
