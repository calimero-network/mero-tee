# Baked at build time; part of this image's measurements. The files it names
# are inference-init's: the configuration it measured into RTMR3 and the
# access-token hashes from metadata (see mero-inference-gate/src/main.rs).
GATE_LISTEN_ADDR=0.0.0.0:{{ mero_inference_gate_port }}
GATE_UPSTREAM=http://127.0.0.1:8000
GATE_CONFIG_FILE=/run/mero-inference/config.json
GATE_TOKENS_FILE=/run/mero-inference/access-tokens
GATE_GPU_EVIDENCE=/usr/local/lib/mero-inference/gpu-evidence
RUST_LOG=info
