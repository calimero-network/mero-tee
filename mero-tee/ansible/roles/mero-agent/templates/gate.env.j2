# Baked at build time; part of this image's measurements. Nothing here comes
# from instance metadata (see mero-agent-gate/src/main.rs).
GATE_LISTEN_ADDR=0.0.0.0:{{ mero_agent_gate_port }}
GATE_STATE_DIR=/mnt/agent
GATE_REQUIRE_MOUNT=true
GATE_SHARE_GROUP={{ mero_agent_user }}
GATE_PROVISIONERS_FILE=/etc/mero-agent/provisioners
GATE_IMAGE_PROFILE_FILE=/etc/mero-agent/image-profile
GATE_ALLOW_UNAUTHENTICATED_PROVISIONING={{ 'true' if (mero_agent_provisioners_file | length == 0 and lockdown_profile != 'locked-read-only') else 'false' }}
RUST_LOG=info
