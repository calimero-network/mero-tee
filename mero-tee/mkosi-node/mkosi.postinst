#!/bin/bash
# Runs in the image after its packages and file trees are in. Enables what the
# roles enable (build.sh lists it from the render manifest; the image's presets
# say the same) and locks root. The masks are applied in mkosi.finalize: mkosi
# runs `systemctl preset-all` after this script, and disabling a template
# (getty@.service) there removes its masked instances.
set -euo pipefail

while read -r unit; do
  if [[ -n "${unit}" ]]; then systemctl --root="${BUILDROOT}" enable "${unit}"; fi
done < "${SRCDIR}/rendered/enable.list"

# What the Ubuntu cloud image's netplan did: DHCP on the NIC (80-gce.network),
# DNS through the metadata server, time from it.
systemctl --root="${BUILDROOT}" enable systemd-networkd.service systemd-resolved.service systemd-timesyncd.service

# merod-lockdown R4: lock root.
mkosi-chroot usermod --lock root
