#!/bin/bash
# Fleet HA sidecar: polls MDMA for group assignments and drives merod via meroctl.
# Runs as a systemd service alongside merod on ReadOnly TEE fleet nodes.
#
# MDMA_URL is baked at image build time via Ansible (measured into MRTD).
# NO CREDENTIAL IS BAKED: the fleet token is issued by mdma when this node's
# attestation verifies, and stored at $FLEET_TOKEN_FILE.
# TLS is always verified.
set -euo pipefail

LOG="/var/log/fleet-sidecar.log"
# CONFIRMED_FILE tracks the groups for which mdma's /confirm has been
# called AFTER the local `fleet-join` returned admitted=true. Semantics
# differ from the pre-retry STATE_FILE (which only tracked "we tried"
# — and that's exactly what made the old design fire-once-and-give-up).
# Different path so any pre-upgrade legacy state is ignored on first boot.
CONFIRMED_FILE="/var/lib/calimero/fleet-confirmed.json"
# Per-namespace record of the authorship grant we last told mdma about, so a
# grant made (or revoked) AFTER admission gets re-reported exactly once per
# change rather than on every one-second cycle. See `reconcile_authorship`.
AUTHORSHIP_FILE="/var/lib/calimero/fleet-authorship.json"
# The context inventory we last successfully POSTed, per namespace, plus when
# the last authoritative (`full`) post landed. Change detection compares against
# this, so a steady-state node posts nothing at all. See `reconcile_inventory`.
INVENTORY_FILE="/var/lib/calimero/fleet-inventory.json"
POLL_INTERVAL=1
# How often the group tree is WALKED. Not the post interval — a walk that finds
# nothing changed posts nothing. Core exposes no "contexts changed" signal, so
# a poll is the only detector available; at one walk a minute a namespace with
# a handful of groups costs a few `meroctl` subprocesses a minute, against the
# dozens a second a 1 Hz walk would cost for data that changes a few times a day.
INVENTORY_SCAN_INTERVAL=60
# How often a `full` (authoritative, pruning) post is sent regardless of whether
# anything changed. This is what repairs a missed change: an incremental post
# can only add, so a context the node no longer holds is removed from mdma here
# or not at all.
INVENTORY_FULL_INTERVAL=900
# How often the executor account is re-read while it is still unavailable.
# Only ever runs before the first successful read: once the account is known it
# is fixed for the life of the node and this stops costing anything. Long
# enough that a merod slow to come up does not fork `meroctl` once a second,
# short enough that a node is registered and certifiable within a minute of
# merod answering.
ACCOUNT_RETRY_INTERVAL=15
# How often a node with no fleet token retries registration. Each attempt costs
# a TDX quote and spends a single-use challenge, so this is not something to do
# on the 1 Hz loop; long enough to be cheap, short enough that a node is usable
# within a minute of mdma being able to issue it one.
REGISTRATION_RETRY_INTERVAL=30
# Per (namespace, account): the envelope version last accepted by mdma, and a
# hash of the PLAINTEXT it was sealed from. Sealing is non-deterministic — every
# call mints a fresh ephemeral sender key, so two seals of identical data differ
# in every byte. Change detection therefore compares plaintext hashes; comparing
# ciphertexts would see a change on every pass, burn a version number each time,
# and rewrite mdma forever for data that never moved. See `reconcile_recovery`.
# The identity mdma last ACCEPTED a registration for. Compared against the
# node's current identity each cycle, so a re-key or a new relay url
# re-registers and anything else costs nothing. Written only after mdma
# accepted, so a refusal or an outage is retried rather than recorded as done.
REGISTRATION_FILE="/var/lib/calimero/fleet-registration.json"
RECOVERY_FILE="/var/lib/calimero/fleet-recovery.json"
# How often recovery envelopes are reconsidered. Far slower than the inventory
# walk: this costs a `meroctl account seal-to` subprocess per changed account on
# top of the walk, and the data behind it (which namespaces an account belongs
# to) changes on the order of days, not minutes.
RECOVERY_SCAN_INTERVAL=300
# How often every envelope is re-sealed and re-posted even with no detected
# change. The repair path for a write mdma lost, a row an operator deleted, or a
# local state file wiped by a reimage — none of which the node can observe.
RECOVERY_FULL_INTERVAL=86400
# core's `DEFAULT_LIST_LIMIT` (crates/server/src/admin/handlers/groups.rs), and
# `meroctl` exposes no --offset/--limit for `group contexts list` /
# `group members list`. A page that comes back exactly this long may have been
# truncated, and there is no way to tell from here — so it is treated as an
# INCOMPLETE read rather than as a complete one, which is what keeps a `full`
# post from pruning rows for contexts that merely fell off page one.
MEROCTL_PAGE_LIMIT=100
# Hard stop on the group walk. A cycle in the parent/child index would otherwise
# hang the sidecar; `seen` already prevents revisiting, so this only bounds the
# pathological case of a genuinely enormous namespace — which is likewise
# reported as incomplete rather than silently half-reported.
MAX_GROUP_WALK=512
# Wall-clock budget for one namespace's walk. The walk runs INSIDE the
# one-second reconcile loop, so while it is running this node is not polling
# `should-join` — and that poll is what drives the safety-critical leave path.
# A hung `meroctl` would otherwise stall it for 30s per group. Past the budget
# the walk stops and reports what it has, marked incomplete, which is the same
# safe answer as any other partial read.
INVENTORY_WALK_BUDGET=20
MEROCTL="meroctl --home /mnt/data/calimero --node default"
# `MemberCapabilities::CAN_AUTHOR_ON_BEHALF` — bit 9 of the per-member u32
# bitmask in core (crates/context/config/src/lib.rs). The grant delegated
# execution runs on, and implied by nothing else: not membership, not admin,
# and not the subgroup-admit cascade.
CAN_AUTHOR_ON_BEHALF=512

log() { echo "[$(date -Iseconds)] $*" | tee -a "$LOG"; }

mkdir -p "$(dirname "$CONFIRMED_FILE")"
[[ -f "$CONFIRMED_FILE" ]] || echo '[]' > "$CONFIRMED_FILE"
[[ -f "$AUTHORSHIP_FILE" ]] || echo '{}' > "$AUTHORSHIP_FILE"
[[ -f "$INVENTORY_FILE" ]] || echo '{"namespaces":{},"last_full":0}' > "$INVENTORY_FILE"

# Baked at image build time by Ansible (not from instance metadata)
MDMA_URL="{{ fleet_mdma_url }}"
# The token authenticating this node to /api/fleet/*. NOT baked into the image:
# it is issued by `POST /api/fleet/nodes/register` once mdma has verified a TDX
# quote whose MRTD is allowlisted, and is scoped to this peer id.
#
# The image used to carry one shared fleet-wide secret. It was never the
# security boundary -- it proved "some fleet node" while the quote proved which
# one, and everything that mattered was already gated on the quote -- but it did
# sit in an artifact whose distribution is not fully controlled, and rotating it
# meant rebuilding every image and re-allowlisting the MRTD.
#
# Survives restarts so a node does not re-register on every boot; a lost or
# rejected token simply means registering again, which costs one quote.
FLEET_TOKEN_FILE="/var/lib/calimero/fleet-token"
FLEET_TOKEN="$(cat "$FLEET_TOKEN_FILE" 2>/dev/null || true)"

if [[ -z "${MDMA_URL:-}" ]]; then
  log "ERROR: fleet_mdma_url not set at build time. Fleet sidecar cannot start."
  exit 1
fi

# Only used to report how long the executor account took to become readable,
# which is the difference between "merod was a little slow" and "something is
# wrong with this node".
SIDECAR_STARTED_AT=$(date +%s)
log "Fleet sidecar starting (mdma=$MDMA_URL poll=${POLL_INTERVAL}s)"

# Wait for merod to answer, but never forever, and never in silence.
#
# This was `while ! meroctl peers >/dev/null 2>&1; do sleep 1; done`: no bound,
# no line inside the loop, and stderr discarded. A node whose merod never came
# up stopped here permanently and said nothing at all -- no poll, no
# registration, no certificate, no DNS record, no relay -- while looking
# perfectly healthy from outside, because merod's own port was answering and
# only `meroctl` was not. On a profile with no shell there is then no way left
# to ask what happened.
#
# Three changes, each closing one of those:
#
#   * BOUNDED. Past the budget this returns non-zero and the caller carries on.
#     Carrying on is right: `get_peer_id` reads config.toml directly rather than
#     through merod, so the sidecar can still register, still poll, and still be
#     SEEN by mdma -- and `reconcile_executor_account` keeps retrying the read
#     that failed. Blocking here converts a merod that is slow, or a single
#     broken subcommand, into a node that is permanently invisible.
#   * PROGRESS. A line every `MEROD_WAIT_LOG_EVERY` attempts, so the journal
#     distinguishes "still waiting, 90s in" from "died before it got here".
#   * STDERR KEPT. `meroctl`'s own complaint is the whole diagnosis -- a missing
#     home directory, a refused connection, an unparseable config all look
#     identical once `2>/dev/null` has eaten them.
MEROD_WAIT_TIMEOUT=600
MEROD_WAIT_LOG_EVERY=30
wait_for_merod() {
  local waited=0 err
  log "Waiting for merod..."
  while true; do
    err=$($MEROCTL --output-format json peers 2>&1 >/dev/null) && break
    if (( waited >= MEROD_WAIT_TIMEOUT )); then
      log "ERROR: merod did not answer 'meroctl peers' within ${MEROD_WAIT_TIMEOUT}s; \
continuing anyway so this node is at least visible to mdma. Last error: ${err:-<none>}"
      return 1
    fi
    if (( waited > 0 && waited % MEROD_WAIT_LOG_EVERY == 0 )); then
      log "Still waiting for merod after ${waited}s: ${err:-<no stderr>}"
    fi
    sleep 1
    waited=$(( waited + 1 ))
  done
  log "merod is ready (after ${waited}s)"
  return 0
}

get_peer_id() {
  local cfg="/mnt/data/calimero/default/config.toml"
  python3 -c 'import tomllib,sys; print(tomllib.load(open(sys.argv[1],"rb"))["identity"]["peer_id"])' "$cfg" 2>/dev/null \
    || grep -A5 '^\[identity\]' "$cfg" 2>/dev/null | grep -E '^[[:space:]]*peer_id[[:space:]]*=' | head -1 | sed -E 's/.*"([^"]+)".*/\1/'
}

# Read this TDX guest's own MRTD (Measurement Register of Trust Domain) from
# the kernel-exposed sysfs attribute. This is the same 48-byte value the Intel
# QE writes into a TDX quote (quote.mrtd()); the kernel surfaces it directly so
# no quote generation / configfs-tsm round-trip is required. Output is 96-hex
# lowercase, no "0x" prefix -- exactly what mdma's MRTD allowlist compares.
get_mrtd() {
  local f="/sys/class/misc/tdx_guest/measurements/mrtd:sha384"
  [[ -r "$f" ]] || return 1
  # xxd is in the image (vim-common); od is the coreutils fallback.
  if command -v xxd >/dev/null 2>&1; then
    xxd -p -c 48 "$f" 2>/dev/null | tr -d '\n' | tr 'A-F' 'a-f'
  else
    od -An -v -tx1 "$f" 2>/dev/null | tr -d ' \n' | tr 'A-F' 'a-f'
  fi
}

# The account this node WRITES AS — what a warrant's `executor` field must name.
#
# An account, not this node's signing key, and that distinction is the whole
# reason a client can be told it once: the account is a content address derived
# from a root inside the TEE, so the node re-keying does not void warrants
# already issued to it. mdma cannot derive it (it never sees inside the TEE) and
# a client cannot either, so this hop is the only way it reaches them.
#
# Stable for the life of the node, hence read once at startup like the MRTD.
get_executor_account() {
  local out
  out=$($MEROCTL --output-format json account show 2>>"$LOG") || return 1
  echo "$out" | python3 -c '
import sys, json
try:
  obj = json.loads(sys.stdin.read())
  data = obj.get("data") if isinstance(obj.get("data"), dict) else obj
  account = (data or {}).get("accountId") or (data or {}).get("account_id") or ""
except Exception as exc:
  print(f"sidecar: failed to parse meroctl account show JSON: {exc}", file=sys.stderr)
  account = ""
print(account.strip().lower())
' 2>>"$LOG"
}

# Proof that this instance is one mdma created, presented once at registration.
#
# Per-node and stamped as instance metadata at creation, so it is NOT in the
# image -- which is the whole point. A TDX quote proves a genuine enclave
# running a measured image; it does not prove the machine is mdma's. Without
# this, anyone with TDX hardware could register and be issued a fleet token.
get_enrolment_token() {
  curl -sf -H "Metadata-Flavor: Google" \
    "http://metadata.google.internal/computeMetadata/v1/instance/attributes/enrolment-token" \
    2>/dev/null | tr -d '\r\n' || true
}

# The URL clients present intents to.
#
# From instance metadata rather than derived: merod terminates no TLS and sits
# behind traefik on a host it was never told about, so `public_ip` is not an
# address a client can verify a certificate against. Whoever provisioned the DNS
# is the only party that knows, and mdma's dispatcher writes it here when it
# does (`MDMA_TEE_RELAY_URL_TEMPLATE`). Empty when it does not, which mdma then
# reports as "no relay URL" — an honest absence rather than an address that
# fails TLS verification on the client.
get_relay_url() {
  curl -sf -H "Metadata-Flavor: Google" \
    "http://metadata.google.internal/computeMetadata/v1/instance/attributes/relay-url" \
    2>/dev/null | tr -d '\r\n' || true
}

# --- Observability credential ------------------------------------------------
#
# The bearer token vector and vmagent present to the observability front end.
#
# TWO SOURCES, AND THE SPLIT IS THE POINT. Instance metadata is the BOOTSTRAP:
# calimero-init reads `observability-token` and writes this very file before any
# unit starts, so a node ships logs whether or not the sidecar ever runs. This
# poll is the REFRESH: it is how a rotated token reaches a node that is already
# running, without recreating it -- and recreation is the only other way, since
# instance metadata is written at creation and never backfilled.
#
# The refresh existed first and was the only source, which made the
# observability path depend on the thing it observes: this poll needs a fleet
# token, that needs attested registration, and that needs this loop to be
# running. A node that never reached its first poll could never ship the logs
# that would say why. calimero-init reading the same credential at boot is what
# breaks that circle; this half stays because rotation still has to land.
#
# The two agree by construction: both write THIS file, with `printf '%s'` and no
# trailing newline, and mdma decides whether to re-send by comparing SHA-256 of
# its token against the fingerprint reported from this file. A node booted with
# a current token reports a matching fingerprint and the credential never rides
# the poll at all.
#
# Secret Manager is not a third option, and not for policy reasons: mdma creates
# these instances with no service account at all, so there is no cloud identity
# here for `gcloud` or the metadata server's token endpoint to use.
LOGS_TOKEN_FILE="/etc/vector/provided_token"

# Where vector ships to. Instance metadata, like the relay URL, and NOT a
# secret -- only the credential comes down the fleet channel. `get_meta` lives
# in calimero-init, not here, so this reads the metadata server directly the
# same way `get_relay_url` does.
logs_endpoint() {
  curl -sf -H "Metadata-Flavor: Google" \
    "http://metadata.google.internal/computeMetadata/v1/instance/attributes/logs-endpoint" \
    2>/dev/null | tr -d '\r\n' || true
}

# Where vmagent ships to. Same shape, same reasoning, different signal -- and
# read here for the same reason the logs endpoint is: a rotation has to
# reconfigure BOTH shippers, or metrics keep presenting the superseded token
# while logs move on, and the node half-authenticates.
metrics_endpoint() {
  curl -sf -H "Metadata-Flavor: Google" \
    "http://metadata.google.internal/computeMetadata/v1/instance/attributes/metrics-endpoint" \
    2>/dev/null | tr -d '\r\n' || true
}

# SHA-256 of the token this node holds, or empty. Reported on every poll so
# mdma can send the token only when ours is wrong -- never the token itself,
# which must not travel back up.
logs_token_fp() {
  [[ -s "$LOGS_TOKEN_FILE" ]] || return 0
  sha256sum "$LOGS_TOKEN_FILE" 2>/dev/null | awk '{print $1}' || true
}

# Memoised on mtime, like the certificate expiry: the poll runs once a second
# and would otherwise hash a file that changes about never.
LOGS_TOKEN_MTIME=""
LOGS_TOKEN_FP=""
cached_logs_token_fp() {
  local mtime
  mtime=$(stat -c %Y "$LOGS_TOKEN_FILE" 2>/dev/null || echo "0")
  if [[ "$mtime" != "$LOGS_TOKEN_MTIME" ]]; then
    LOGS_TOKEN_MTIME="$mtime"
    LOGS_TOKEN_FP="$(logs_token_fp)"
  fi
  echo "$LOGS_TOKEN_FP"
}

# Install a token mdma delivered, then (re)configure and restart both shippers.
#
# The endpoints are NOT secrets and stay in instance metadata; only the
# credential comes down this channel. With no endpoint for a signal there is
# nowhere to send it, so the token is stored and that shipper is left alone --
# an operator can set the metadata and recreate without mdma having to
# re-deliver.
#
# BOTH shippers, not just vector. They present the same bearer token to the same
# vmauth front end, so a rotation that reconfigured only vector would leave
# vmagent holding the superseded one and every sample would start being rejected
# -- silently, at the sink, on a node with no shell to notice it from. The two
# are configured together or the node is half-authenticated.
#
# `logq` throughout: this function is reachable from the poll's response
# handler, whose STDOUT IS the assignments payload. A stray line on stdout
# corrupts the parse and drives the LEAVE path, which purges keys.
install_logs_token() {
  local token="$1"
  [[ -n "$token" ]] || return 0

  mkdir -p /etc/vector

  local tmp="${LOGS_TOKEN_FILE}.$$"
  # `umask` in a subshell, not `chmod` afterwards: the unit sets no UMask, so
  # systemd's default 0022 creates this 0644 and a post-hoc chmod only closes
  # the window after the secret is already on disk world-readable. The chmod
  # stays as a belt-and-braces assertion of the final mode.
  ( umask 077; printf '%s' "$token" > "$tmp" ) || { rm -f "$tmp"; return 1; }
  chmod 600 "$tmp"
  mv -f "$tmp" "$LOGS_TOKEN_FILE"
  logq "Observability token installed ($(cached_logs_token_fp))"

  configure_vector_with_token
  configure_vmagent_with_token
  return 0
}

# (Re)point vector at the logs endpoint with the token this node now holds.
configure_vector_with_token() {
  local endpoint
  endpoint=$(logs_endpoint)

  if [[ -z "$endpoint" ]]; then
    logq "WARN: no logs-endpoint instance metadata; token stored but vector not started \
(set MDMA_TEE_METADATA_LOGS_ENDPOINT on the dispatcher and recreate the node)"
    return 0
  fi

  if [[ ! -x /etc/vector/configure_vector.sh || ! -f /etc/vector/vector_partial.yaml ]]; then
    logq "WARN: vector config or script missing; token stored but vector not started"
    return 0
  fi

  if /etc/vector/configure_vector.sh \
      /etc/vector/vector_partial.yaml "$endpoint" "true" "provided" "$LOGS_TOKEN_FILE" >>"$LOG" 2>&1; then
    systemctl restart vector >>"$LOG" 2>&1 \
      && logq "vector restarted against $endpoint" \
      || logq "WARN: vector restart failed; see $LOG"
  else
    logq "WARN: configure_vector.sh failed; see $LOG"
  fi
  return 0
}

# (Re)point vmagent at the metrics endpoint with the same token.
#
# `configure_vmagent.sh` rewrites the unit file and restarts the service itself,
# so unlike vector there is no separate restart to do here.
configure_vmagent_with_token() {
  local endpoint
  endpoint=$(metrics_endpoint)

  if [[ -z "$endpoint" ]]; then
    logq "No metrics-endpoint instance metadata; vmagent not started \
(set MDMA_TEE_METADATA_METRICS_ENDPOINT on the dispatcher and recreate the node)"
    return 0
  fi

  if [[ ! -x /etc/vmagent/configure_vmagent.sh || ! -f /etc/vmagent/scrape_config.yml ]]; then
    logq "WARN: vmagent config or script missing; token stored but vmagent not started"
    return 0
  fi

  if /etc/vmagent/configure_vmagent.sh \
      /etc/vmagent/scrape_config.yml "$endpoint" "true" "provided" "$LOGS_TOKEN_FILE" >>"$LOG" 2>&1; then
    logq "vmagent reconfigured against $endpoint"
  else
    logq "WARN: configure_vmagent.sh failed; see $LOG"
  fi
  return 0
}

# --- TLS -------------------------------------------------------------------
#
# The node holds a key it generated itself, in the enclave, before traefik
# started (calimero-init). That key never leaves: what travels is a CSR, what
# comes back is a signed certificate. mdma orders it over ACME DNS-01 for the
# name this node committed to in its attestation quote, so the hostname on the
# certificate is bound to the measurement rather than merely claimed.
TLS_DIR="/mnt/data/tls"
TLS_KEY="$TLS_DIR/key.pem"
TLS_CERT="$TLS_DIR/cert.pem"

# `log`, minus the copy on stdout.
#
# `log` tees, so anything it prints lands in the command substitution of a
# caller reading a function's value. The functions below RETURN on stdout, so a
# warning logged the usual way is captured AS the value -- a CSR field holding
# "WARN: no TLS key at ...". The record still reaches $LOG.
logq() { log "$@" >/dev/null; }

# The hostname inside a relay URL. Empty when none is configured, which is also
# when there is nothing to certify.
relay_host() {
  python3 -c '
import sys
from urllib.parse import urlsplit
print(urlsplit(sys.argv[1]).hostname or "")
' "${1:-}" 2>/dev/null || true
}

# A CSR over the node key for `host`, base64 DER.
#
# Cached beside the key: it is deterministic for (key, host), and regenerating
# it every  pass would change the value the registration nonce commits to for no
# reason. Keyed on the host so a node that moves behind a different name asks
# for the new one instead of re-presenting its old certificate.
node_csr_b64() {
  local host="$1"
  [[ -n "$host" ]] || return 1
  [[ -s "$TLS_KEY" ]] || { logq "WARN: no TLS key at $TLS_KEY; cannot request a certificate"; return 1; }

  local cached="$TLS_DIR/csr-${host}.b64"
  if [[ ! -s "$cached" ]]; then
    local der="$TLS_DIR/.csr.der.$$"
    if ! openssl req -new -key "$TLS_KEY" -subj "/CN=${host}" \
        -addext "subjectAltName=DNS:${host}" -outform DER -out "$der" >>"$LOG" 2>&1; then
      rm -f "$der"
      logq "WARN: could not build a CSR for ${host}"
      return 1
    fi
    if ! base64 -w0 "$der" > "$cached" 2>>"$LOG"; then
      rm -f "$der" "$cached"
      return 1
    fi
    rm -f "$der"
    find "$TLS_DIR" -maxdepth 1 -name 'csr-*.b64' ! -name "csr-${host}.b64" -delete 2>/dev/null || true
  fi
  cat "$cached"
}

# When the installed certificate expires (RFC3339), or empty.
#
# Empty is what drives issuance: mdma orders a certificate for any node that
# reports no expiry, and renews one reporting an expiry close at hand. The
# placeholder calimero-init writes is self-signed, so issuer == subject, and it
# is reported as empty on purpose -- reporting its real notAfter would tell mdma
# this node is covered for ten years and no certificate would ever be ordered.
installed_cert_not_after() {
  [[ -s "$TLS_CERT" ]] || return 0
  local issuer subject enddate
  issuer=$(openssl x509 -in "$TLS_CERT" -noout -issuer 2>/dev/null | sed 's/^issuer=//')
  subject=$(openssl x509 -in "$TLS_CERT" -noout -subject 2>/dev/null | sed 's/^subject=//')
  [[ -n "$issuer" ]] || return 0
  [[ "$issuer" != "$subject" ]] || return 0
  enddate=$(openssl x509 -in "$TLS_CERT" -noout -enddate 2>/dev/null | sed 's/^notAfter=//')
  [[ -n "$enddate" ]] || return 0
  date -u -d "$enddate" +%Y-%m-%dT%H:%M:%SZ 2>/dev/null || true
}

# `installed_cert_not_after`, memoised on the certificate file's mtime.
#
# The poll below runs once a second and would otherwise fork three openssl
# processes every time to re-read a value that changes twice a quarter.
TLS_CERT_MTIME=""
TLS_CERT_NOT_AFTER=""
cached_cert_not_after() {
  local mtime
  mtime=$(stat -c %Y "$TLS_CERT" 2>/dev/null || echo "0")
  if [[ "$mtime" != "$TLS_CERT_MTIME" ]]; then
    TLS_CERT_MTIME="$mtime"
    TLS_CERT_NOT_AFTER="$(installed_cert_not_after)"
  fi
  echo "$TLS_CERT_NOT_AFTER"
}

# Install a chain mdma returned -- but only if it matches the key we hold.
#
# A mismatched certificate fails nowhere visible: traefik loads it happily and
# every client handshake breaks, on a node mdma has already advertised as a
# relay. Comparing the two public keys costs one openssl call and turns a silent
# fleet-wide outage into a refusal in the log.
install_certificate() {
  local pem="$1"
  [[ -n "$pem" ]] || return 0
  [[ -s "$TLS_KEY" ]] || return 1

  local tmp="$TLS_DIR/.cert.pem.$$"
  printf '%s\n' "$pem" > "$tmp" 2>>"$LOG" || { rm -f "$tmp"; return 1; }

  local from_cert from_key
  from_cert=$(openssl x509 -in "$tmp" -noout -pubkey 2>>"$LOG" | openssl sha256 2>/dev/null || true)
  from_key=$(openssl pkey -in "$TLS_KEY" -pubout 2>>"$LOG" | openssl sha256 2>/dev/null || true)
  if [[ -z "$from_cert" || "$from_cert" != "$from_key" ]]; then
    log "WARN: mdma returned a certificate that does not match this node's key; not installing"
    rm -f "$tmp"
    return 1
  fi

  if cmp -s "$tmp" "$TLS_CERT"; then
    rm -f "$tmp"
    return 0
  fi

  chmod 0644 "$tmp"
  mv -f "$tmp" "$TLS_CERT" 2>>"$LOG" || { rm -f "$tmp"; return 1; }

  # Traefik watches its dynamic CONFIG file, not the certificate files that
  # file names, so replacing the bytes behind `defaultCertificate` is invisible
  # to it. The config sits on the measured, read-only root and must not be
  # rewritten to provoke a reload, so a restart is how a new chain takes effect:
  # about a second, at first issuance and at each renewal.
  if systemctl restart traefik >>"$LOG" 2>&1; then
    log "Installed TLS certificate (expires $(installed_cert_not_after))"
  else
    log "WARN: certificate installed but traefik restart failed; it serves the old one until restarted"
  fi
}

# Whether this node holds CAN_AUTHOR_ON_BEHALF on a namespace — i.e. whether it
# can actually serve delegated execution there.
#
# Read from core rather than assumed, because it is not ours to decide: the
# capability is a governance op signed by an admin of the namespace, arriving
# over gossip at some arbitrary time after admission. Prints `true` or `false`;
# any failure prints `false`, which is the safe direction — mdma then does not
# advertise this node as a writable relay and clients are not sent to mint
# warrants it would refuse.
check_authorship() {
  local group_id="$1"
  if [[ -z "${EXECUTOR_ACCOUNT:-}" ]]; then
    echo "false"
    return 0
  fi
  local out rc
  rc=0
  out=$($MEROCTL --output-format json group members get-capabilities "$group_id" "$EXECUTOR_ACCOUNT" 2>>"$LOG") || rc=$?
  if [[ $rc -ne 0 ]]; then
    echo "false"
    return 0
  fi
  echo "$out" | python3 -c "
import sys, json
try:
  obj = json.loads(sys.stdin.read())
  data = obj.get('data') if isinstance(obj.get('data'), dict) else obj
  caps = int((data or {}).get('capabilities') or 0)
except Exception as exc:
  print(f'sidecar: failed to parse get-capabilities JSON: {exc}', file=sys.stderr)
  caps = 0
print('true' if caps & $CAN_AUTHOR_ON_BEHALF else 'false')
" 2>>"$LOG" || echo "false"
}

poll_mdma() {
  local peer_id="$1"
  local mrtd="$2"

  local headers=(-H "Content-Type: application/json")
  [[ -n "${FLEET_TOKEN:-}" ]] && headers+=(-H "X-Fleet-Token: ${FLEET_TOKEN}")

  # SAFETY-CRITICAL: distinguish a real "no assignments" answer from a poll
  # failure. The pre-leave version swallowed ANY curl error into
  # `{"assignments":[]}`, which made a transient mdma outage indistinguishable
  # from "all namespaces disabled". Now that a missing assignment triggers
  # `namespace leave` (which IRREVERSIBLY PURGES KEYS), that conflation would
  # let a single network blip evict + shred keys on every healthy replica.
  #
  # So we mirror confirm_assignment's 0/1 contract: capture curl's body AND
  # its exit status separately, validate the body parses as an assignments
  # object, and ONLY then print the body and return 0. Any curl error
  # (non-2xx via -f, timeout, DNS) OR an unparseable body returns 1 with NO
  # stdout, so the caller can leave `confirmed` state untouched and skip the
  # entire reconcile/leave/prune cycle this round.
  # The poll doubles as the relay-identity report: `executor_account` and
  # `relay_url` are node-level facts mdma cannot derive, and this is the one
  # request it already makes every second. Empty values are skipped mdma-side,
  # so a node with no relay URL configured still polls and still replicates.
  # It also carries when this node's certificate expires, which is what drives
  # issuance and renewal: mdma orders one for a node reporting no expiry, and
  # renews one whose expiry is close. Empty covers both "never issued" and "the
  # self-signed placeholder", so a fresh node asks for a certificate simply by
  # polling, and renewal needs no separate request from here at all.
  local body rc response
  body=$(python3 -c '
import json, sys
print(json.dumps({
  "peer_id": sys.argv[1],
  "mrtd": sys.argv[2],
  "executor_account": sys.argv[3],
  "relay_url": sys.argv[4],
  "tls_cert_not_after": sys.argv[5],
  "logs_token_fp": sys.argv[6],
}))' "$peer_id" "$mrtd" "${EXECUTOR_ACCOUNT:-}" "${RELAY_URL:-}" "$(cached_cert_not_after)" "$(cached_logs_token_fp)" 2>>"$LOG") || body="{\"peer_id\":\"$peer_id\",\"mrtd\":\"$mrtd\"}"

  response=$(curl -sf --max-time 10 "${headers[@]}" \
    -d "$body" \
    "${MDMA_URL}/api/fleet/should-join" 2>>"$LOG")
  rc=$?

  if [[ $rc -ne 0 ]]; then
    log "WARN: POST /api/fleet/should-join failed (rc=$rc); skipping reconcile this cycle (state preserved)"
    return 1
  fi

  # Validate the body is JSON with an 'assignments' array before trusting it.
  # An HTTP 200 that returns a non-JSON / wrong-shape body (proxy error page,
  # truncated response) must NOT be read as "no assignments" — that would
  # trigger leaves just like a swallowed error. Reject it as a poll failure.
  if ! echo "$response" | python3 -c "
import sys, json
data = json.load(sys.stdin)
if not isinstance(data.get('assignments'), list):
    sys.exit(1)
" 2>>"$LOG"; then
    log "WARN: /api/fleet/should-join returned an unparseable/unexpected body; skipping reconcile this cycle (state preserved)"
    return 1
  fi

  # Certificate delivery rides this response. No new endpoint and no blocking
  # call: issuance is asynchronous on mdma's side, so the chain simply appears
  # on whichever poll follows it, and renewal takes the identical path.
  #
  # stdout is the assignments payload this function returns, and `log` tees to
  # stdout — so the install runs with stdout closed. Its log lines still reach
  # $LOG; letting them reach the caller would corrupt the JSON that drives the
  # leave path.
  local pem
  pem=$(echo "$response" | python3 -c "
import json, sys
value = json.load(sys.stdin).get('tls_certificate')
print(value if isinstance(value, str) else '')
" 2>>"$LOG") || pem=""
  if [[ -n "$pem" ]]; then
    install_certificate "$pem" >/dev/null || true
  fi

  # The observability token rides the same response, for the same reasons, and
  # with the same stdout discipline: this function's stdout IS the assignments
  # payload, so the install must not print to it.
  local logs_token
  logs_token=$(echo "$response" | python3 -c "
import json, sys
value = json.load(sys.stdin).get('logs_token')
print(value if isinstance(value, str) else '')
" 2>>"$LOG") || logs_token=""
  if [[ -n "$logs_token" ]]; then
    install_logs_token "$logs_token" >/dev/null || true
  fi

  echo "$response"
  return 0
}

confirm_assignment() {
  local peer_id="$1"
  local group_id="$2"
  # Whether we can serve delegated execution here. Passed in rather than read
  # inside, because the caller already knows: the join path has just checked it,
  # and `reconcile_authorship` calls this precisely BECAUSE the answer changed.
  local authorship_ready="${3:-false}"

  local headers=(-H "Content-Type: application/json")
  [[ -n "${FLEET_TOKEN:-}" ]] && headers+=(-H "X-Fleet-Token: ${FLEET_TOKEN}")

  # Return curl's actual exit code so the caller can decide whether to
  # mark the group confirmed-locally or leave it for retry. The pre-
  # retry version swallowed errors with `|| true`, which meant a
  # transient mdma blip (restart, network glitch) caused the sidecar
  # to permanently mark the group confirmed even though mdma never
  # heard about it — re-creating the original fire-once bug on the
  # confirm step. stderr goes to the log so ops still see what failed.
  if curl -sf --max-time 10 "${headers[@]}" \
      -d "{\"peer_id\":\"$peer_id\",\"group_id\":\"$group_id\",\"authorship_ready\":$authorship_ready}" \
      "${MDMA_URL}/api/fleet/confirm" 2>>"$LOG"; then
    return 0
  else
    log "WARN: POST /api/fleet/confirm failed for $group_id; will retry next cycle"
    return 1
  fi
}

load_authorship() {
  cat "$AUTHORSHIP_FILE" 2>/dev/null || echo '{}'
}

save_authorship() {
  echo "$1" > "$AUTHORSHIP_FILE"
}

# Re-report the authorship grant for already-confirmed namespaces when it
# changes.
#
# The grant almost never exists at admission time: core implies
# CAN_AUTHOR_ON_BEHALF from nothing, so a namespace is authorship-closed until
# an admin publishes a governance op — minutes, hours or days after this node
# joined. Without this the join-time answer would be frozen forever and a
# namespace that was granted the capability would still show `authorship_ready:
# false` in the cloud, so no client would ever be sent to this relay.
#
# Only re-POSTs on a CHANGE, not every cycle: the loop runs once a second and
# mdma's /confirm is a write. The recorded state is updated only when the POST
# succeeded, so a transient mdma blip retries on the next change-detection pass
# rather than being lost.
reconcile_authorship() {
  local peer_id="$1"
  local confirmed="$2"
  local recorded updated changed
  recorded=$(load_authorship)
  updated="$recorded"
  changed=0

  for group_id in $(echo "$confirmed" | python3 -c "import sys,json; [print(g) for g in json.loads(sys.stdin.read())]" 2>/dev/null); do
    local now was
    now=$(check_authorship "$group_id")
    was=$(echo "$recorded" | python3 -c "
import sys, json
try:
  print('true' if json.load(sys.stdin).get('$group_id') else 'false')
except Exception:
  print('false')
" 2>/dev/null || echo "false")
    [[ "$now" == "$was" ]] && continue
    if confirm_assignment "$peer_id" "$group_id" "$now"; then
      log "Authorship grant for $group_id is now $now; reported to mdma"
      updated=$(echo "$updated" | python3 -c "
import sys, json
try:
  state = json.load(sys.stdin)
except Exception:
  state = {}
state['$group_id'] = $( [[ "$now" == "true" ]] && echo True || echo False )
print(json.dumps(state, sort_keys=True))
" 2>>"$LOG" || echo "$updated")
      changed=1
    fi
  done

  # Prune namespaces we no longer hold, so a re-join is treated as new rather
  # than inheriting a stale "already reported" verdict.
  local pruned
  pruned=$(python3 -c "
import json, sys
state = json.loads('''$updated''')
keep = set(json.loads('''$confirmed'''))
print(json.dumps({k: v for k, v in state.items() if k in keep}, sort_keys=True))
" 2>>"$LOG" || echo "$updated")
  if [[ "$pruned" != "$recorded" ]] || [[ $changed -eq 1 ]]; then
    save_authorship "$pruned"
  fi
}

# --- context inventory ------------------------------------------------------
#
# `FleetAssignment` records which NAMESPACES this node replicates, which is one
# level too coarse to route a delegated write: core scopes
# `CAN_AUTHOR_ON_BEHALF` per group, implies it from nothing, and deliberately
# does not propagate it through the subgroup-admit cascade — so this node can
# hold the namespace root's key and grant while being no member at all of a
# restricted subgroup beneath it. Contexts hang off groups, so only a
# per-GROUP report can answer "can this node execute for context X".
#
# Without this reporter `GET /api/cloud/contexts/{id}/relays` reads an empty
# table and answers `servable: false` for every context that exists (mdma#222).

# Walk one namespace's group tree and assemble its `InventoryNamespace`.
#
# Prints ONE JSON object — {"namespace": {...}, "complete": true|false} — and
# returns 0; returns 1 with no stdout when nothing usable could be read.
#
# `complete` is the load-bearing half. A `full` post PRUNES every context row it
# does not mention, per namespace, so a report assembled from partial reads
# would delete live rows and un-advertise a node that is serving them perfectly
# well. Anything that could hide a context — a failed `meroctl`, an unparseable
# body, a page that came back at exactly the limit, the walk cap — clears it,
# and the caller then posts that namespace incrementally instead.
collect_namespace_inventory() {
  local namespace_id="$1"
  MEROCTL_CMD="$MEROCTL" \
  NAMESPACE_ID="$namespace_id" \
  EXECUTOR_ACCOUNT="${EXECUTOR_ACCOUNT:-}" \
  AUTHOR_BIT="$CAN_AUTHOR_ON_BEHALF" \
  PAGE_LIMIT="$MEROCTL_PAGE_LIMIT" \
  MAX_GROUPS="$MAX_GROUP_WALK" \
  WALK_BUDGET="$INVENTORY_WALK_BUDGET" \
  python3 - <<'PY' 2>>"$LOG"
import json
import os
import shlex
import subprocess
import sys
import time

MEROCTL = shlex.split(os.environ["MEROCTL_CMD"])
NAMESPACE_ID = os.environ["NAMESPACE_ID"].strip()
ACCOUNT = os.environ.get("EXECUTOR_ACCOUNT", "").strip()
AUTHOR_BIT = int(os.environ["AUTHOR_BIT"])
PAGE_LIMIT = int(os.environ["PAGE_LIMIT"])
MAX_GROUPS = int(os.environ["MAX_GROUPS"])
DEADLINE = time.monotonic() + float(os.environ["WALK_BUDGET"])

# Cleared by anything that could make the report understate what this node
# holds. Never set back to True.
complete = True


def incomplete(why):
    global complete
    complete = False
    print("sidecar: inventory read incomplete: " + why, file=sys.stderr)


def meroctl(*args, critical=True):
    """Run meroctl and parse its JSON, or return None. Never raises: a node
    mid-restart, a group that vanished between two reads, and a genuinely
    broken command all have to leave the sidecar running.

    `critical` says whether a failure could make the report UNDERSTATE which
    contexts this node holds. Only those clear `complete`. A failed capabilities
    or member-count read is a worse answer about a context that is still being
    reported, not a missing context — and treating it as one would mean a
    namespace whose member list simply exceeds one page could never be pruned
    at all."""
    def failed(why):
        if critical:
            incomplete(why)
        else:
            print("sidecar: " + why, file=sys.stderr)

    try:
        proc = subprocess.run(
            MEROCTL + ["--output-format", "json", *args],
            capture_output=True,
            text=True,
            timeout=max(1.0, DEADLINE - time.monotonic()),
        )
    except Exception as exc:
        failed("meroctl " + " ".join(args) + " did not run: " + str(exc))
        return None
    if proc.returncode != 0:
        failed(
            "meroctl " + " ".join(args) + " exited " + str(proc.returncode)
            + ": " + proc.stderr.strip()[:200]
        )
        return None
    try:
        return json.loads(proc.stdout)
    except Exception as exc:
        failed("meroctl " + " ".join(args) + " returned unparseable JSON: " + str(exc))
        return None


def hexid(entry, *keys):
    for key in keys:
        value = entry.get(key)
        if isinstance(value, str) and value.strip():
            return value.strip().lower()
    return ""


def maybe_truncated(entries, what, critical=True):
    """A list exactly one page long is indistinguishable from a truncated one:
    meroctl passes no offset/limit, so page two is unreachable from here."""
    if len(entries) < PAGE_LIMIT:
        return False
    why = what + " came back at the " + str(PAGE_LIMIT) + "-row page limit"
    if critical:
        incomplete(why)
    else:
        print("sidecar: " + why, file=sys.stderr)
    return True


def child_groups(group_id):
    response = meroctl("group", "subgroups", group_id)
    if response is None:
        return []
    entries = response.get("subgroups")
    if not isinstance(entries, list):
        incomplete("group subgroups " + group_id + " had no 'subgroups' array")
        return []
    return [gid for gid in (hexid(e, "groupId", "group_id") for e in entries if isinstance(e, dict)) if gid]


def group_contexts(group_id):
    """Context ids in one group, or None when the answer could not be read.

    None and [] are deliberately different: [] is 'this group holds no
    contexts', which a `full` post is entitled to act on, while None means the
    group is omitted from the report AND the namespace is marked incomplete, so
    nothing is pruned on the strength of a read that failed."""
    response = meroctl("group", "contexts", "list", group_id)
    if response is None:
        return None
    entries = response.get("data")
    if not isinstance(entries, list):
        incomplete("group contexts list " + group_id + " had no 'data' array")
        return None
    maybe_truncated(entries, "group contexts list " + group_id)
    return [cid for cid in (hexid(e, "contextId", "context_id") for e in entries if isinstance(e, dict)) if cid]


def authorship_ready(group_id):
    """Whether this node may write on members' behalf in THIS group.

    Re-asked per group rather than inherited from the namespace: core does not
    propagate the grant down the subgroup cascade, and inheriting it is exactly
    the lie this endpoint exists to prevent — a client would learn the truth by
    minting a warrant, which spends a nonce it cannot get back.

    Unreadable is `false`, matching `check_authorship`: mdma then does not
    advertise the node for that group, which is the safe direction. It does NOT
    clear `complete` — false is a real answer about a context that is still
    being reported, not a gap that could cause a wrongful prune."""
    if not ACCOUNT:
        return False
    response = meroctl("group", "members", "get-capabilities", group_id, ACCOUNT, critical=False)
    if response is None:
        return False
    data = response.get("data") if isinstance(response.get("data"), dict) else response
    try:
        return bool(int((data or {}).get("capabilities") or 0) & AUTHOR_BIT)
    except Exception as exc:
        print("sidecar: could not read capabilities for " + group_id + ": " + str(exc), file=sys.stderr)
        return False


def member_count():
    """Members of the namespace root group — a COUNT, never a roster. The
    aggregation happens here, inside the TEE and inside the group's key, so no
    account id crosses the wire to mdma at all.

    A truncated page would be an undercount, and an undercount reads as a real
    number. None reads as 'did not look', which is the truth."""
    response = meroctl("group", "members", "list", NAMESPACE_ID, critical=False)
    if response is None:
        return None
    entries = response.get("members")
    if not isinstance(entries, list):
        print("sidecar: group members list " + NAMESPACE_ID + " had no 'members' array", file=sys.stderr)
        return None
    if maybe_truncated(entries, "group members list " + NAMESPACE_ID, critical=False):
        return None
    return len(entries)


if not NAMESPACE_ID:
    sys.exit(1)

# Breadth-first over the group tree, starting AT the namespace root: the
# namespace is itself a group and holds contexts of its own, and
# `namespace groups` would have returned only its direct children.
group_ids = []
seen = set()
queue = [NAMESPACE_ID]
while queue and len(group_ids) < MAX_GROUPS and time.monotonic() < DEADLINE:
    group_id = queue.pop(0)
    if not group_id or group_id in seen:
        continue
    seen.add(group_id)
    group_ids.append(group_id)
    queue.extend(child_groups(group_id))
if queue:
    incomplete(
        "group walk stopped early with " + str(len(queue)) + " group(s) unvisited "
        "(cap " + str(MAX_GROUPS) + ", budget " + os.environ["WALK_BUDGET"] + "s)"
    )

groups = []
distinct_contexts = set()
for group_id in group_ids:
    if time.monotonic() >= DEADLINE:
        incomplete("ran out of walk budget before reading every group's contexts")
        break
    context_ids = group_contexts(group_id)
    if context_ids is None:
        # Unreadable: omit the group entirely. `complete` is already cleared,
        # so this namespace will not be posted as authoritative and the rows
        # mdma already holds for it survive.
        continue
    if not context_ids:
        # Nothing to advertise, and no reason to spend a capabilities read.
        continue
    distinct_contexts.update(context_ids)
    groups.append(
        {
            "group_id": group_id,
            "context_ids": sorted(set(context_ids)),
            "authorship_ready": authorship_ready(group_id),
        }
    )

if not groups and not complete:
    # Nothing read and nothing trustworthy to say. Reporting an empty namespace
    # here would be indistinguishable from 'this node holds no contexts'.
    sys.exit(1)

namespace = {"namespace_id": NAMESPACE_ID, "groups": groups}

members = member_count()
if members is not None:
    namespace["member_count"] = members
if complete:
    # Only meaningful when every group was read; otherwise it is an undercount
    # wearing the clothes of a real number.
    namespace["context_count"] = len(distinct_contexts)

print(json.dumps({"namespace": namespace, "complete": complete}, sort_keys=True))
PY
}

load_inventory() {
  cat "$INVENTORY_FILE" 2>/dev/null || echo '{"namespaces":{},"last_full":0}'
}

save_inventory() {
  echo "$1" > "$INVENTORY_FILE"
}

# POST one batch of assembled namespaces. `full` is a request-level flag in
# mdma's `InventoryRequest`, which is why complete and partial namespaces go in
# separate posts rather than one mixed one.
#
# Returns curl's success, like `confirm_assignment`: the caller must not record
# a report it never delivered, or the change is lost until something else
# happens to change again.
post_inventory() {
  local peer_id="$1"
  local full="$2"
  shift 2
  [[ $# -eq 0 ]] && return 0

  local body
  body=$(python3 -c '
import json, sys
peer, full = sys.argv[1], sys.argv[2] == "true"
namespaces = [json.loads(arg)["namespace"] for arg in sys.argv[3:]]
print(json.dumps({"peer_id": peer, "namespaces": namespaces, "full": full}))
' "$peer_id" "$full" "$@" 2>>"$LOG") || {
    log "WARN: could not assemble the inventory body; skipping this post"
    return 1
  }

  local headers=(-H "Content-Type: application/json")
  [[ -n "${FLEET_TOKEN:-}" ]] && headers+=(-H "X-Fleet-Token: ${FLEET_TOKEN}")

  if curl -sf --max-time 15 "${headers[@]}" \
      -d "$body" \
      "${MDMA_URL}/api/fleet/inventory" >/dev/null 2>>"$LOG"; then
    return 0
  fi
  log "WARN: POST /api/fleet/inventory failed (full=$full); will retry next scan"
  return 1
}

# Report the context inventory for every confirmed namespace.
#
# Posts on CHANGE, with a slow periodic `full` pass. Both halves are needed:
# without change detection this writes to mdma every cycle for data that moves a
# few times a day, and without the periodic full pass an incremental-only stream
# can never REMOVE a context — it would keep advertising a node for a context it
# has left until something unrelated triggered a full report.
#
# `full` is claimed only for namespaces whose walk came back complete. That is
# the whole reason `collect_namespace_inventory` tracks it: mdma prunes per
# reported namespace, so one failed `meroctl` inside a `full` report deletes
# live rows.
reconcile_inventory() {
  local peer_id="$1"
  local confirmed="$2"
  local force_full="${3:-false}"

  local recorded now last_full want_full
  recorded=$(load_inventory)
  now=$(date +%s)
  last_full=$(echo "$recorded" | python3 -c "
import sys, json
try:
  print(int(json.load(sys.stdin).get('last_full') or 0))
except Exception:
  print(0)
" 2>/dev/null || echo 0)
  want_full=false
  if [[ "$force_full" == "true" ]] || (( now - last_full >= INVENTORY_FULL_INTERVAL )); then
    want_full=true
  fi

  local complete_batch=() partial_batch=()
  local namespace_id out rc
  for namespace_id in $(echo "$confirmed" | python3 -c "import sys,json; [print(n) for n in json.loads(sys.stdin.read())]" 2>/dev/null); do
    rc=0
    out=$(collect_namespace_inventory "$namespace_id") || rc=$?
    if [[ $rc -ne 0 ]] || [[ -z "$out" ]]; then
      log "WARN: could not read the context inventory for $namespace_id; leaving mdma's copy untouched"
      continue
    fi
    if echo "$out" | python3 -c "import sys,json; sys.exit(0 if json.load(sys.stdin).get('complete') else 1)" 2>/dev/null; then
      complete_batch+=("$out")
    else
      log "Context inventory for $namespace_id is partial; reporting it additively (no prune)"
      partial_batch+=("$out")
    fi
  done

  # Whether anything actually moved since the last successful post. A `full`
  # pass posts regardless — that is what makes it a reconcile.
  local changed
  changed=$(python3 -c "
import json, sys
recorded = json.loads(sys.argv[1]).get('namespaces') or {}
seen = {}
for arg in sys.argv[2:]:
    namespace = json.loads(arg)['namespace']
    seen[namespace['namespace_id']] = namespace
if any(recorded.get(k) != v for k, v in seen.items()):
    print('true')
else:
    print('false')
" "$recorded" ${complete_batch[@]+"${complete_batch[@]}"} ${partial_batch[@]+"${partial_batch[@]}"} 2>>"$LOG" || echo true)

  local posted=() full_landed=false
  if [[ ${#complete_batch[@]} -gt 0 ]] && { [[ "$want_full" == "true" ]] || [[ "$changed" == "true" ]]; }; then
    if post_inventory "$peer_id" "$want_full" "${complete_batch[@]}"; then
      posted+=("${complete_batch[@]}")
      [[ "$want_full" == "true" ]] && full_landed=true
    fi
  fi
  if [[ ${#partial_batch[@]} -gt 0 ]] && [[ "$changed" == "true" ]]; then
    if post_inventory "$peer_id" false "${partial_batch[@]}"; then
      posted+=("${partial_batch[@]}")
    fi
  fi

  # Record only what mdma actually acknowledged, and prune namespaces we no
  # longer hold so a re-join reports from scratch instead of inheriting a stale
  # "already told them" verdict.
  local updated
  updated=$(python3 -c "
import json, sys
state = json.loads(sys.argv[1])
namespaces = state.get('namespaces') or {}
keep = set(json.loads(sys.argv[2]))
last_full = int(state.get('last_full') or 0)
if sys.argv[3] == 'true':
    last_full = int(sys.argv[4])
for arg in sys.argv[5:]:
    namespace = json.loads(arg)['namespace']
    namespaces[namespace['namespace_id']] = namespace
namespaces = {k: v for k, v in namespaces.items() if k in keep}
print(json.dumps({'namespaces': namespaces, 'last_full': last_full}, sort_keys=True))
" "$recorded" "$confirmed" "$full_landed" "$now" ${posted[@]+"${posted[@]}"} 2>>"$LOG" || echo "$recorded")

  if [[ "$updated" != "$recorded" ]]; then
    save_inventory "$updated"
    if [[ ${#posted[@]} -gt 0 ]]; then
      log "Reported the context inventory for ${#posted[@]} namespace(s) (full=$full_landed)"
    fi
  fi
}

# --- account recovery envelopes ---------------------------------------------
#
# Holding a root key recovers the ACCOUNT; it does not recover the LIST of
# namespaces that account belongs to, because namespaces are separate keypairs
# and the local governance state left with the lost device. A relay is the only
# party that can record that list: it holds the group key, can enumerate the
# membership, and can seal to a member's account root.
#
# One envelope per (account, namespace) THIS node serves — not one per account.
# A relay only ever sees the namespaces it serves, so a per-account envelope
# would be a partial list overwriting other relays' partial lists
# (calimero-network/mdma#228, fixed by keying mdma's table per namespace).


# Assemble, for one namespace, the plaintext each linked member's envelope
# should carry. Emits {"complete": bool, "accounts": {<account>: {...}}}.
#
# `complete` is the load-bearing part. A relay that cannot finish the walk must
# write NOTHING for this namespace: a shorter list overwriting a longer one at a
# higher version is the same silent data loss as a clobber, with a valid version
# number on it.
collect_recovery_plan() {
  local namespace_id="$1"
  MEROCTL_CMD="$MEROCTL" \
  NAMESPACE_ID="$namespace_id" \
  PAGE_LIMIT="$MEROCTL_PAGE_LIMIT" \
  MAX_GROUPS="$MAX_GROUP_WALK" \
  WALK_BUDGET="$INVENTORY_WALK_BUDGET" \
  python3 - <<'PY' 2>>"$LOG"
import hashlib
import json
import os
import shlex
import subprocess
import sys
import time

MEROCTL = shlex.split(os.environ["MEROCTL_CMD"])
NAMESPACE_ID = os.environ["NAMESPACE_ID"].strip().lower()
PAGE_LIMIT = int(os.environ["PAGE_LIMIT"])
MAX_GROUPS = int(os.environ["MAX_GROUPS"])
DEADLINE = time.monotonic() + float(os.environ["WALK_BUDGET"])

complete = True


def incomplete(why):
    global complete
    complete = False
    print("sidecar: recovery read incomplete: " + why, file=sys.stderr)


def meroctl(*args):
    try:
        proc = subprocess.run(
            MEROCTL + ["--output-format", "json", *args],
            capture_output=True,
            text=True,
            timeout=max(1.0, DEADLINE - time.monotonic()),
        )
    except Exception as exc:
        incomplete("meroctl " + " ".join(args) + " did not run: " + str(exc))
        return None
    if proc.returncode != 0:
        incomplete("meroctl " + " ".join(args) + " exited " + str(proc.returncode))
        return None
    try:
        return json.loads(proc.stdout)
    except Exception as exc:
        incomplete("meroctl " + " ".join(args) + " returned unparseable JSON: " + str(exc))
        return None


def page_complete(entries, what):
    """A list exactly one page long may be truncated, and meroctl exposes no
    offset. An undercount here would drop a group or a membership from someone's
    recovery list, so it counts as incomplete."""
    if len(entries) >= PAGE_LIMIT:
        incomplete(what + " came back at the " + str(PAGE_LIMIT) + "-row page limit")
        return False
    return True


def child_groups(group_id):
    response = meroctl("group", "subgroups", group_id)
    if response is None:
        return []
    entries = response.get("subgroups")
    if not isinstance(entries, list):
        incomplete("group subgroups " + group_id + " had no 'subgroups' array")
        return []
    page_complete(entries, "group subgroups " + group_id)
    out = []
    for entry in entries:
        value = entry.get("group_id") or entry.get("groupId") or entry.get("id")
        if isinstance(value, str) and value.strip():
            out.append(value.strip().lower())
    return out


def group_members(group_id):
    response = meroctl("group", "members", "list", group_id)
    if response is None:
        return []
    entries = response.get("members")
    if not isinstance(entries, list):
        incomplete("group members list " + group_id + " had no 'members' array")
        return []
    page_complete(entries, "group members list " + group_id)
    out = []
    for entry in entries:
        value = entry.get("identity") or entry.get("account")
        if isinstance(value, str) and value.strip():
            out.append(value.strip().lower())
    return out


def member_devices(group_id):
    """`{account: [{"device_id", "signing_key"}]}` for one group.

    The account is the authorization subject and the device is what signs, so
    this is the only thing that maps a member back to the keys that will appear
    on their ops — and, for recovery, back to the `device_id` that
    `POST /namespaces/:id/account/revoke` takes.

    A holder who lost every device cannot get this from a node afterwards.
    `GET /admin-api/account/devices` is unmapped in core's permission validator,
    so it falls to default-deny and needs `admin`; the session a recovering
    holder can actually obtain is `account_proof`, which carries `context:query`,
    `context:intent` and `context:subscribe` and nothing else. The envelope is
    the only path, which is why the list is sealed into it rather than looked up
    later.
    """
    response = meroctl("group", "member-devices", group_id)
    if response is None:
        return {}
    entries = response.get("members")
    if not isinstance(entries, list) and isinstance(response.get("data"), dict):
        entries = response["data"].get("members")
    if not isinstance(entries, list):
        incomplete("group member-devices " + group_id + " had no 'members' array")
        return {}
    page_complete(entries, "group member-devices " + group_id)
    out = {}
    for entry in entries:
        account = entry.get("account") or entry.get("identity")
        if not isinstance(account, str) or not account.strip():
            continue
        devices = entry.get("devices")
        if not isinstance(devices, list):
            continue
        # Paginated per MEMBER, and the device count per member is unbounded
        # where the member count is not. A member at the page limit is the same
        # undercount as a truncated member list and counts the same way.
        page_complete(devices, "devices of " + account[:12] + " in " + group_id)
        rows = []
        for device in devices:
            device_id = device.get("device_id") or device.get("deviceId")
            signing_key = device.get("signing_key") or device.get("signingKey")
            if isinstance(device_id, str) and device_id.strip():
                rows.append({
                    "device_id": device_id.strip().lower(),
                    "signing_key": (signing_key or "").strip().lower(),
                })
        out[account.strip().lower()] = rows
    return out

def group_contexts(group_id):
    response = meroctl("group", "contexts", "list", group_id)
    if response is None:
        return []
    entries = response.get("data")
    if not isinstance(entries, list):
        incomplete("group contexts list " + group_id + " had no 'data' array")
        return []
    page_complete(entries, "group contexts list " + group_id)
    out = []
    for entry in entries:
        value = entry.get("context_id") or entry.get("contextId") or entry.get("id")
        if isinstance(value, str) and value.strip():
            out.append(value.strip().lower())
    return out


if not NAMESPACE_ID:
    sys.exit(1)

# Walk the group tree once, collecting membership and contexts per group.
seen = set()
queue = [NAMESPACE_ID]
per_group = []
while queue and len(seen) < MAX_GROUPS:
    if time.monotonic() >= DEADLINE:
        incomplete("ran out of walk budget")
        break
    group_id = queue.pop()
    if group_id in seen:
        continue
    seen.add(group_id)
    per_group.append(
        (group_id, group_members(group_id), group_contexts(group_id), member_devices(group_id))
    )
    for child in child_groups(group_id):
        if child not in seen:
            queue.append(child)

if len(seen) >= MAX_GROUPS and queue:
    incomplete("hit the " + str(MAX_GROUPS) + "-group walk ceiling")

# Invert to per-account, for EVERY member.
#
# This used to keep only accounts linked to a cloud login, on the grounds that
# nobody else could read an envelope: the only read path went through
# `/api/cloud/me/accounts/{id}/recovery-envelope`, which needs a cloud session
# and a link. That premise is gone -- mdma now serves
# `POST /api/cloud/accounts/recovery-envelope` against a root signature, so the
# holder of the account root can read its own envelopes whether or not it has
# ever seen a cloud login.
#
# Writing only for linked accounts meant an unlinked keyholder who lost their
# last device had nothing to recover from, and would find that out at the one
# moment no retroactive fix exists. The cost of the wider write is storage and
# mdma learning the (account, namespace) edge for non-customers -- an edge it
# could already derive, since it assigned the relay that would write the row.
accounts = {}
for group_id, members, contexts, devices in per_group:
    for account in members:
        record = accounts.setdefault(
            account, {"groups": set(), "contexts": set(), "devices": {}}
        )
        record["groups"].add(group_id)
        record["contexts"].update(contexts)
        # ONLY this account's own devices. Another member's device ids are no
        # use to a recovering holder and would widen what one envelope
        # discloses about everyone else in the namespace, which is the opposite
        # of what sealing per account is for.
        #
        # Keyed by device id so a device appearing in several groups is carried
        # once: a device is certified by the account root, not by a group, and
        # revocation is per namespace -- which this envelope already is.
        for device in devices.get(account) or []:
            record["devices"][device["device_id"]] = device

plans = {}
for account, record in accounts.items():
    # Self-contained on purpose: `namespace_id` is repeated inside the sealed
    # body so an envelope is interpretable without trusting the cleartext key it
    # arrived under. `v` so the shape can move without guessing.
    payload = {
        # v2 adds `devices`. Nothing decodes this payload in production yet, so
        # the bump costs nothing today and is what stops a future reader from
        # guessing whether an absent `devices` means "no devices" or "written
        # before the field existed".
        "v": 2,
        "namespace_id": NAMESPACE_ID,
        "groups": sorted(record["groups"]),
        "contexts": sorted(record["contexts"]),
        "devices": [
            record["devices"][key] for key in sorted(record["devices"])
        ],
    }
    plaintext = json.dumps(payload, sort_keys=True, separators=(",", ":"))
    plans[account] = {
        "plaintext": plaintext,
        # Hash of the PLAINTEXT, never of the ciphertext: sealing mints a fresh
        # ephemeral key every call, so identical data seals to different bytes
        # and a ciphertext comparison would report a change on every pass.
        "sha256": hashlib.sha256(plaintext.encode()).hexdigest(),
    }

print(json.dumps({"complete": complete, "accounts": plans}, sort_keys=True))
PY
}

# Seal one plaintext to an account's ROOT key, via core's `meroctl account
# seal-to` (calimero-network/core#3918). Prints the envelope mdma should store.
#
# The recipient is the account ROOT, never a device key: a device is exactly
# what is gone in the case worth sealing for, so an envelope addressed to one is
# valid, opaque, and unopenable precisely when it is needed. `seal-to` resolves
# the root itself; this node never names a key.
#
# mdma's `ciphertext` is one opaque string, while a sealed envelope is four
# fields (epoch, ephemeral key, nonce, ciphertext) and a recovering holder needs
# all four. So the whole envelope is JSON-encoded into that string. mdma stores
# it without looking, exactly as it stores everything else here.
seal_for_account() {
  local group_id="$1"
  local account="$2"
  local plaintext="$3"

  local sealed
  sealed=$(printf '%s' "$plaintext" | $MEROCTL --output-format json account seal-to "$group_id" "$account" 2>>"$LOG") || {
    log "WARN: sealing for $account in $group_id failed; leaving mdma's copy untouched"
    return 1
  }
  echo "$sealed" | python3 -c "
import json, sys
env = json.load(sys.stdin)
need = ('accountRootEpoch', 'ephemeralPublicKey', 'nonce', 'ciphertext')
if not all(k in env for k in need):
    sys.exit(1)
print(json.dumps({k: env[k] for k in need}, sort_keys=True))
" 2>>"$LOG" || {
    log "WARN: meroctl account seal-to returned an unexpected envelope for $account; skipping"
    return 1
  }
}

load_recovery() {
  cat "$RECOVERY_FILE" 2>/dev/null || echo '{"envelopes":{},"last_full":0}'
}

save_recovery() {
  echo "$1" > "$RECOVERY_FILE"
}

# PUT one envelope. Returns curl's success: a version must not be recorded
# locally unless mdma accepted it, or the next pass believes it is already
# stored and the write is lost until the plaintext happens to change again.
put_recovery_envelope() {
  local peer_id="$1" account="$2" namespace_id="$3" ciphertext="$4" version="$5"

  local body
  body=$(python3 -c '
import json, sys
print(json.dumps({
    "peer_id": sys.argv[1],
    "account_id": sys.argv[2],
    "namespace_id": sys.argv[3],
    "ciphertext": sys.argv[4],
    "version": int(sys.argv[5]),
}))
' "$peer_id" "$account" "$namespace_id" "$ciphertext" "$version" 2>>"$LOG") || return 1

  local headers=(-H "Content-Type: application/json")
  [[ -n "${FLEET_TOKEN:-}" ]] && headers+=(-H "X-Fleet-Token: ${FLEET_TOKEN}")

  if curl -sf --max-time 15 -X PUT "${headers[@]}" \
      -d "$body" \
      "${MDMA_URL}/api/fleet/recovery-envelope" >/dev/null 2>>"$LOG"; then
    return 0
  fi
  log "WARN: PUT /api/fleet/recovery-envelope failed for $account in $namespace_id (v$version)"
  return 1
}

# Write an envelope for every linked member of every namespace this node serves,
# on change and on a slow periodic pass.
#
# `version` is monotonic per (account, namespace) and survives restarts because
# it lives in RECOVERY_FILE rather than in memory or in wall-clock: mdma rejects
# a version that goes backwards with a 409, and a counter that reset on restart
# would strand the envelope at a version mdma will no longer accept.
reconcile_recovery() {
  local peer_id="$1"
  local confirmed="$2"
  local force_full="${3:-false}"

  local state now last_full want_full
  state=$(load_recovery)
  now=$(date +%s)
  last_full=$(echo "$state" | python3 -c "
import sys, json
try:
  print(int(json.load(sys.stdin).get('last_full') or 0))
except Exception:
  print(0)
" 2>/dev/null || echo 0)
  want_full=false
  if [[ "$force_full" == "true" ]] || (( now - last_full >= RECOVERY_FULL_INTERVAL )); then
    want_full=true
  fi

  local namespace_id plan wrote_any=false
  for namespace_id in $(echo "$confirmed" | python3 -c "import sys,json; [print(n) for n in json.loads(sys.stdin.read())]" 2>/dev/null); do
    plan=$(collect_recovery_plan "$namespace_id") || plan=""
    if [[ -z "$plan" ]]; then
      log "WARN: could not assemble recovery plans for $namespace_id; leaving mdma's copies untouched"
      continue
    fi
    if ! echo "$plan" | python3 -c "import sys,json; sys.exit(0 if json.load(sys.stdin).get('complete') else 1)" 2>/dev/null; then
      # The criterion that matters: a partial list at a higher version destroys
      # a good one just as effectively as a stale copy would.
      log "Recovery plan for $namespace_id is incomplete; writing nothing rather than a partial list"
      continue
    fi

    local account entry plaintext digest known_digest version
    for account in $(echo "$plan" | python3 -c "import sys,json; [print(a) for a in sorted(json.load(sys.stdin)['accounts'])]" 2>/dev/null); do
      entry=$(echo "$plan" | python3 -c "
import sys, json
print(json.dumps(json.load(sys.stdin)['accounts'][sys.argv[1]]))
" "$account" 2>/dev/null) || continue
      plaintext=$(echo "$entry" | python3 -c "import sys,json; print(json.load(sys.stdin)['plaintext'])" 2>/dev/null) || continue
      digest=$(echo "$entry" | python3 -c "import sys,json; print(json.load(sys.stdin)['sha256'])" 2>/dev/null) || continue

      known_digest=$(echo "$state" | python3 -c "
import sys, json
key = sys.argv[1]
print((json.load(sys.stdin).get('envelopes') or {}).get(key, {}).get('sha256', ''))
" "${namespace_id}/${account}" 2>/dev/null || echo "")

      if [[ "$digest" == "$known_digest" && "$want_full" != "true" ]]; then
        continue
      fi

      version=$(echo "$state" | python3 -c "
import sys, json
key = sys.argv[1]
print(int((json.load(sys.stdin).get('envelopes') or {}).get(key, {}).get('version', 0)) + 1)
" "${namespace_id}/${account}" 2>/dev/null || echo 1)

      local sealed
      sealed=$(seal_for_account "$namespace_id" "$account" "$plaintext") || continue
      if put_recovery_envelope "$peer_id" "$account" "$namespace_id" "$sealed" "$version"; then
        state=$(echo "$state" | python3 -c "
import sys, json
state = json.load(sys.stdin)
state.setdefault('envelopes', {})[sys.argv[1]] = {'version': int(sys.argv[2]), 'sha256': sys.argv[3]}
print(json.dumps(state, sort_keys=True))
" "${namespace_id}/${account}" "$version" "$digest" 2>/dev/null || echo "$state")
        wrote_any=true
        log "Recovery envelope written for $account in $namespace_id (v$version)"
      fi
    done
  done

  if [[ "$want_full" == "true" ]]; then
    state=$(echo "$state" | python3 -c "
import sys, json
state = json.load(sys.stdin)
state['last_full'] = int(sys.argv[1])
print(json.dumps(state, sort_keys=True))
" "$now" 2>/dev/null || echo "$state")
    wrote_any=true
  fi

  [[ "$wrote_any" == "true" ]] && save_recovery "$state"
  return 0
}

# --- attested node registration ---------------------------------------------
#
# Everything this sidecar tells mdma about itself — peer id, executor account,
# relay url, mrtd — used to be taken on trust. The only credential is a
# fleet-wide token that says "some node" and never "which node", so mdma could
# not tell one node's claims from another's, and `should_join` compared a
# REPORTED mrtd against a customer's measurement allowlist
# (calimero-network/mdma#225).
#
# Registration binds those claims to a quote. Nothing here signs anything: the
# executor account is minted inside the TEE and never leaves it, so an
# allowlisted image saying what its account is is exactly what attestation is
# for. The binding goes in the quote's report-data nonce.

# The merod HTTP port, for `/admin-api/tee/attest`. Same instance-metadata key
# and same default `calimero-init` uses, rather than a second source of truth.
get_server_port() {
  local port
  port=$(curl -sf -H "Metadata-Flavor: Google" \
    "http://metadata.google.internal/computeMetadata/v1/instance/attributes/server-port" \
    2>/dev/null | tr -d '\r\n' || true)
  echo "${port:-2428}"
}

load_registration() {
  cat "$REGISTRATION_FILE" 2>/dev/null || echo '{}'
}

save_registration() {
  echo "$1" > "$REGISTRATION_FILE"
}

# Persist the token mdma issued, and start using it immediately.
#
# 0600 and written via a temp file so a crash mid-write cannot leave a truncated
# credential that would 401 every call until the next registration.
save_fleet_token() {
  local token="$1"
  [[ -n "$token" ]] || return 0
  mkdir -p "$(dirname "$FLEET_TOKEN_FILE")"
  local tmp="${FLEET_TOKEN_FILE}.$$"
  # See `install_logs_token`: created under a restrictive umask rather than
  # chmod-ed down after the fact, so the token is never briefly world-readable.
  ( umask 077; printf '%s' "$token" > "$tmp" ) || { rm -f "$tmp"; return 1; }
  chmod 600 "$tmp"
  mv -f "$tmp" "$FLEET_TOKEN_FILE"
  FLEET_TOKEN="$token"
}

# Ask merod for a quote committing to `nonce_hex`.
#
# `/admin-api/tee/attest` is mounted unauthenticated (on `tee::service()`, not
# `protected_service()`), so this reaches it over loopback with no token — which
# is why no core change was needed for any of this.
#
# Deliberately NO `application_id`: `build_report_data(nonce, None)` leaves the
# second half of report data as zeros, and the whole identity binding lives in
# the nonce. mdma verifies against zeros for that half and its own code says the
# check is vacuous, so sending an application id here would change what mdma
# must expect for no gain.
attest_quote() {
  local nonce_hex="$1"
  local port="$2"
  local body
  body=$(curl -sf --max-time 30 -H "Content-Type: application/json" \
    -d "{\"nonce\":\"${nonce_hex}\"}" \
    "http://127.0.0.1:${port}/admin-api/tee/attest" 2>>"$LOG") || {
    log "WARN: /admin-api/tee/attest did not answer; cannot register this pass"
    return 1
  }
  echo "$body" | python3 -c "
import json, sys
payload = json.load(sys.stdin)
data = payload.get('data') if isinstance(payload.get('data'), dict) else payload
quote = data.get('quoteB64') or payload.get('quoteB64') or ''
if not isinstance(quote, str) or not quote.strip():
    sys.exit(1)
print(quote.strip())
" 2>>"$LOG" || {
    log "WARN: /admin-api/tee/attest returned no quoteB64; cannot register this pass"
    return 1
  }
}

# Register this node's identity with mdma, binding it to a fresh quote.
#
# Returns 0 only when mdma accepted. Anything else leaves the recorded state
# untouched so the next pass tries again — including mdma's 503, which means
# "the quote could not be EVALUATED" (Intel collateral unreachable, verifier
# missing) rather than "your quote is bad". Those are different answers and
# retrying the first is correct; treating it as a refusal and giving up would
# leave a healthy node permanently unregistered because of someone else's
# outage.
register_with_mdma() {
  local peer_id="$1" account="$2" relay_url="$3" port="$4"

  local headers=()
  [[ -n "${FLEET_TOKEN:-}" ]] && headers+=(-H "X-Fleet-Token: ${FLEET_TOKEN}")

  local challenge
  challenge=$(curl -sf --max-time 15 "${headers[@]}" \
    "${MDMA_URL}/api/fleet/nodes/challenge" 2>>"$LOG" \
    | python3 -c "
import json, sys
value = json.load(sys.stdin).get('challenge')
if not isinstance(value, str) or not value.strip():
    sys.exit(1)
print(value.strip())
" 2>>"$LOG") || {
    log "WARN: could not get a registration challenge from mdma; will retry"
    return 1
  }

  # A CSR for the name in the relay URL, so the certificate mdma orders is for a
  # key this enclave generated. Absent when there is no relay URL: nothing to
  # certify, and the four-field binding below is what an older node image sent.
  local csr_b64=""
  local host
  host=$(relay_host "$relay_url")
  if [[ -n "$host" ]]; then
    csr_b64=$(node_csr_b64 "$host" || true)
  fi

  # The binding mdma recomputes from the request body. Field order and the
  # separator are part of the contract — get either wrong and the quote is
  # rejected as bound to a different identity, which is the mechanism working.
  #
  # The CSR digest joins it as a fifth field so the quote proves not just WHICH
  # NODE is asking but WHICH KEY gets certified; without it a quote is a valid
  # identity claim that says nothing about the key travelling beside it. Omitted
  # entirely when there is no CSR, which is the shape mdma accepts from a node
  # image that predates this — a fleet node that only replicates still registers.
  local nonce_hex
  nonce_hex=$(python3 -c "
import hashlib, sys
parts = list(sys.argv[1:5])
csr = sys.argv[5]
if csr:
    parts.append(hashlib.sha256(csr.encode()).hexdigest())
print(hashlib.sha256('|'.join(parts).encode()).hexdigest())
" "$challenge" "$peer_id" "$account" "$relay_url" "$csr_b64" 2>>"$LOG") || return 1

  local quote
  quote=$(attest_quote "$nonce_hex" "$port") || return 1

  local body
  body=$(python3 -c '
import json, sys
payload = {"peer_id": sys.argv[1],
           "executor_account": sys.argv[2],
           "relay_url": sys.argv[3],
           "challenge": sys.argv[4],
           "quote": sys.argv[5],
           "enrolment_token": sys.argv[7]}
if sys.argv[6]:
    payload["csr"] = sys.argv[6]
print(json.dumps(payload))
' "$peer_id" "$account" "$relay_url" "$challenge" "$quote" "$csr_b64" "$(get_enrolment_token)" 2>>"$LOG") || return 1

  # The response body matters now: this call is where the fleet token is
  # ISSUED. mdma mints one scoped to this peer id once the quote verifies, so
  # the node boots holding no credential and earns one by proving what it is.
  local code out
  out="$(mktemp)"
  code=$(curl -s -o "$out" -w '%{http_code}' --max-time 30 -X POST \
    -H "Content-Type: application/json" "${headers[@]}" \
    -d "$body" "${MDMA_URL}/api/fleet/nodes/register" 2>>"$LOG") || code="000"

  case "$code" in
    2*)
      local issued
      issued=$(python3 -c "
import json, sys
try:
    value = json.load(open(sys.argv[1])).get('fleet_token')
except Exception:
    value = ''
print(value if isinstance(value, str) else '')
" "$out" 2>>"$LOG") || issued=""
      rm -f "$out"
      if [[ -n "$issued" ]]; then
        save_fleet_token "$issued"
        log "Registered with mdma (peer=$peer_id); fleet token issued"
      else
        # mdma accepted the registration but issued nothing, which means it has
        # no signing key configured. Say so: every later fleet call will 401 and
        # would otherwise look like a network problem.
        log "WARN: registered (peer=$peer_id) but mdma issued no fleet token; \
/api/fleet/* will reject this node until MDMA_FLEET_TOKEN_SIGNING_KEY is set"
      fi
      return 0 ;;
    403)
      rm -f "$out"
      # A verdict against this node: the quote did not verify, its measurement
      # is not published for this release/profile, or the challenge was spent.
      # Retried on the next pass anyway — a published-policy update is exactly
      # the kind of thing that turns this into a pass without the node changing.
      log "WARN: mdma refused this node's registration (403); it replicates but will not relay" ;;
    503)
      rm -f "$out"
      log "mdma could not evaluate the attestation (503); will retry" ;;
    *)
      rm -f "$out"
      log "WARN: registration POST returned ${code}; will retry" ;;
  esac
  return 1
}

# Re-read the executor account while it is still unavailable.
#
# Its VALUE is fixed for the life of the node, which is why it is read once at
# startup — but its AVAILABILITY at that moment is not, and conflating the two
# is what made this a silent, permanent failure.
#
# `wait_for_merod` runs first and does block until merod answers, so this is NOT
# the unit merely being `After=merod.service`. The gap is narrower and easier to
# miss: `wait_for_merod` polls `meroctl peers`, while this reads
# `meroctl account show`. A merod that serves `peers` has not necessarily minted
# this node's account yet, so the one call can succeed while the other does not.
#
# When it did not, `EXECUTOR_ACCOUNT` stayed empty for the life of the process —
# and `reconcile_registration` returns immediately without one, so the node
# never registered, never had a certificate ordered, never had its name
# published in DNS, and never appeared as a relay. The node looked healthy the
# whole time: it replicated, it polled, and nothing said why it was not a relay.
#
# Costs one `meroctl` fork per ACCOUNT_RETRY_INTERVAL until it answers, and
# nothing whatsoever after that.
#
# Mutates the globals `EXECUTOR_ACCOUNT` and `LAST_ACCOUNT_ATTEMPT`.
reconcile_executor_account() {
  [[ -z "$EXECUTOR_ACCOUNT" ]] || return 0

  local now_ts
  now_ts=$(date +%s)
  (( now_ts - LAST_ACCOUNT_ATTEMPT >= ACCOUNT_RETRY_INTERVAL )) || return 0
  LAST_ACCOUNT_ATTEMPT="$now_ts"

  EXECUTOR_ACCOUNT=$(get_executor_account || true)
  if [[ -n "$EXECUTOR_ACCOUNT" ]]; then
    log "Fleet node executor account: $EXECUTOR_ACCOUNT (readable after $((now_ts - SIDECAR_STARTED_AT))s)"
  fi
  return 0
}

# Register when the identity mdma holds is not the one this node now has.
#
# Re-registers on CHANGE rather than on a timer: a registration does not expire,
# and the identity it binds (peer id, executor account, relay url) is fixed for
# the life of the node unless it re-keys or moves behind a different ingress —
# at which point the old registration describes a node that no longer exists.
reconcile_registration() {
  local peer_id="$1" account="$2" relay_url="$3" port="$4"

  # Nothing to bind yet. Not an error: a node with no account reported cannot be
  # advertised as a relay anyway, so registering a half-identity would only
  # record something that has to be replaced.
  #
  # EDGE-TRIGGERED, like `reconcile_authorship`'s change detection: this runs at
  # 1 Hz, so a line per cycle would be 86,400 a day of the same sentence and the
  # signal would be worse than the silence. One line when the block starts, one
  # when it clears, and nothing in between.
  #
  # The silence is what made this expensive. A node sitting here registers
  # never, is issued no certificate, has no name published and never appears as
  # a relay -- and every external measure of it (merod serving, correct image,
  # MRTD matching the allowlist, metadata stamped) says healthy, because all of
  # those are true. The only thing that was ever wrong was a field this function
  # returns on without a word.
  if [[ -z "$peer_id" || -z "$account" ]]; then
    local missing=""
    [[ -z "$peer_id" ]] && missing="peer_id"
    [[ -z "$account" ]] && missing="${missing:+$missing and }executor account"
    if [[ "${REGISTRATION_BLOCKED_ON:-}" != "$missing" ]]; then
      REGISTRATION_BLOCKED_ON="$missing"
      log "Registration is blocked: no ${missing} yet. This node will not register, \
will not be issued a certificate, will not have a name published and will not be \
advertised as a relay until it has one."
    fi
    return 0
  fi
  if [[ -n "${REGISTRATION_BLOCKED_ON:-}" ]]; then
    log "Registration is no longer blocked (${REGISTRATION_BLOCKED_ON} now known); proceeding"
    REGISTRATION_BLOCKED_ON=""
  fi

  # No token means no access to /api/fleet/*, whatever the recorded identity
  # says. Registration is the only thing that issues one, so a node that has
  # lost its token (or is booting for the first time) must register regardless
  # of whether anything about it changed.
  #
  # ON A CLOCK, not every cycle. This loop runs at 1 Hz and each attempt costs a
  # TDX quote and spends a challenge, so a node mdma will not issue a token to --
  # measurement not yet published, or no signing key configured there -- would
  # otherwise generate a quote a second indefinitely. The identity-change path
  # below needs no such guard: it is a string compare that settles immediately.
  if [[ -z "${FLEET_TOKEN:-}" ]]; then
    local now_ts
    now_ts=$(date +%s)
    # `:-0` so this function stands alone: the loop prologue sets the clock, but
    # the test harness sources only the functions section, and `set -u` would
    # abort on the bare name.
    (( now_ts - ${LAST_REGISTRATION_ATTEMPT:-0} >= REGISTRATION_RETRY_INTERVAL )) || return 0
    LAST_REGISTRATION_ATTEMPT="$now_ts"
    register_with_mdma "$peer_id" "$account" "$relay_url" "$port" || return 0
    save_registration "$(python3 -c '
import json, sys
print(json.dumps({"peer_id": sys.argv[1], "executor_account": sys.argv[2], "relay_url": sys.argv[3]}, sort_keys=True))
' "$peer_id" "$account" "$relay_url" 2>/dev/null || echo '{}')"
    return 0
  fi

  local recorded want
  recorded=$(load_registration | python3 -c "
import json, sys
try:
  state = json.load(sys.stdin)
except Exception:
  state = {}
print('|'.join([state.get('peer_id') or '', state.get('executor_account') or '', state.get('relay_url') or '']))
" 2>/dev/null || echo "")
  want="${peer_id}|${account}|${relay_url}"
  [[ "$recorded" == "$want" ]] && return 0

  if register_with_mdma "$peer_id" "$account" "$relay_url" "$port"; then
    save_registration "$(python3 -c '
import json, sys
print(json.dumps({"peer_id": sys.argv[1], "executor_account": sys.argv[2], "relay_url": sys.argv[3]}, sort_keys=True))
' "$peer_id" "$account" "$relay_url" 2>/dev/null || echo '{}')"
  fi
}

join_group() {
  local group_id="$1"
  log "Attempting fleet-join for group $group_id..."

  # `meroctl tee fleet-join` generates a TDX quote, broadcasts
  # TeeAttestationAnnounce on the namespace topic, and polls for
  # admission for up to MAX_ADMISSION_WAIT (~30s, core's
  # fleet_join.rs:169). The handler returns HTTP 200 with
  # `admitted: true|false` on completion — and meroctl exits 0 in
  # BOTH cases (process success != admission success). So we MUST
  # inspect the response payload, not the exit code, to know
  # whether we're a member.
  local result rc admitted
  # Redirect meroctl's stderr to the sidecar log instead of merging it
  # into stdout. Any tracing spans / warnings / connection diagnostics
  # meroctl emits would otherwise prepend the JSON object in $result
  # and break `json.loads` below, silently forcing admitted=false and
  # an infinite retry loop. Keeping stderr in the log preserves ops
  # diagnostics without corrupting parse.
  #
  # Guard the command substitution under `set -e`: a standalone
  # `result=$(...)` assignment aborts the shell on a non-zero exit BEFORE
  # the next-line `rc=$?` can run. fleet-join is documented to exit 0, but
  # capture rc via `|| rc=$?` so a future non-zero exit can't kill the loop.
  rc=0
  result=$($MEROCTL --output-format json tee fleet-join "$group_id" 2>>"$LOG") || rc=$?

  if [[ $rc -ne 0 ]]; then
    log "ERROR: fleet-join command failed for $group_id (rc=$rc): $result"
    return 1
  fi

  # Parse `admitted` from the JSON. Tolerant to either a flat shape
  # ({"admitted": ..., ...}) or a wrapper ({"data": {...}}). On parse
  # failure, log the error (don't swallow silently) so a future
  # output-shape regression is loud — silent fall-through to
  # admitted=false would re-create the previous fire-and-forget bug
  # in a new disguise.
  admitted=$(echo "$result" | python3 -c '
import sys, json
try:
  obj = json.loads(sys.stdin.read())
  print(bool(obj.get("admitted") or obj.get("data", {}).get("admitted")))
except Exception as exc:
  print(f"sidecar: failed to parse meroctl fleet-join JSON: {exc}", file=sys.stderr)
  print(False)
' 2>>"$LOG" || echo 'False')

  if [[ "$admitted" == "True" ]]; then
    log "Admitted into group $group_id"
    return 0
  else
    log "fleet-join completed but not yet admitted for $group_id; will retry next cycle"
    return 1
  fi
}

leave_group() {
  local group_id="$1"
  log "Leaving namespace $group_id (HA disabled/dropped by mdma)..."

  # `meroctl namespace leave <hex_namespace_id>` publishes MemberLeft at the
  # namespace root and cascades through every descendant group where this node
  # has a direct row, so core evicts us from the namespace + all subgroups and
  # purges our local data + keys (key deletion lands with core #2776 / Part 1).
  #
  # IDEMPOTENT / NON-FATAL: leaving a namespace we already left (or were never
  # a direct member of) returns an error ("nothing to leave" / "not a direct
  # member"). That is benign — the post-condition (we are not a member) already
  # holds. Capture rc explicitly and CONTINUE either way; never abort the loop
  # or exit the sidecar. stderr goes to the log so ops keep diagnostics.
  #
  # Guard the command substitution under `set -e`: a standalone
  # `result=$(...)` assignment aborts the shell on the command's non-zero
  # exit BEFORE the next-line `rc=$?` runs, which would kill the sidecar on
  # the FIRST disable that hits an already-left namespace (the common case).
  # `|| rc=$?` captures the non-zero exit into rc so the benign-error branch
  # below stays reachable and leave remains non-fatal.
  local result rc
  rc=0
  result=$($MEROCTL --output-format json namespace leave "$group_id" 2>>"$LOG") || rc=$?

  if [[ $rc -eq 0 ]]; then
    log "Left namespace $group_id (HA disabled/dropped)"
  else
    # Benign on a node that already left; log and move on (do not fail the loop).
    log "namespace leave for $group_id returned rc=$rc (likely already left / not a member): $result"
  fi
  return 0
}

load_confirmed() {
  cat "$CONFIRMED_FILE" 2>/dev/null || echo '[]'
}

save_confirmed() {
  echo "$1" > "$CONFIRMED_FILE"
}

# --- Main loop ---

# Non-fatal by design -- see the note on the function. A node that cannot talk
# to its own merod is still worth having registered and polling, because that is
# the state someone will need to look at.
wait_for_merod || true

PEER_ID=$(get_peer_id)
if [[ -z "$PEER_ID" ]]; then
  sleep 5
  PEER_ID=$(get_peer_id)
fi
if [[ -z "$PEER_ID" ]]; then
  log "ERROR: Could not get peer_id from merod."
  exit 1
fi
log "Fleet node peer_id: $PEER_ID"

# Compute MRTD once: it is fixed for the life of the (immutable) node image.
# mdma's /api/fleet/should-join gates HA assignments on this value; without it
# every MRTD-allowlisted request is skipped and the node is never assigned.
MRTD=$(get_mrtd || true)
if [[ -z "$MRTD" ]]; then
  log "ERROR: could not read MRTD from /sys/class/misc/tdx_guest/measurements/mrtd:sha384; \
posting peer-id only (mdma will not assign MRTD-gated groups until this is resolved)"
else
  log "Fleet node MRTD: $MRTD"
fi

# Relay identity, read once: both are fixed for the life of the node, and both
# are things only this hop can tell mdma. Never fatal — a node that cannot
# report either still replicates; it simply is not advertised as a relay, and
# clients are never sent to mint warrants it could not honour.
EXECUTOR_ACCOUNT=$(get_executor_account || true)
if [[ -z "$EXECUTOR_ACCOUNT" ]]; then
  log "WARN: could not read this node's account from 'meroctl account show' yet; \
retrying every ${ACCOUNT_RETRY_INTERVAL}s (the node replicates meanwhile, and is not \
offered for delegated execution until it answers)"
else
  log "Fleet node executor account: $EXECUTOR_ACCOUNT"
fi

SERVER_PORT=$(get_server_port)
RELAY_URL=$(get_relay_url)
if [[ -z "$RELAY_URL" ]]; then
  log "No relay-url instance metadata; mdma will report no relay URL for this node \
(set MDMA_TEE_RELAY_URL_TEMPLATE on the dispatcher to publish one)"
else
  log "Fleet node relay url: $RELAY_URL"
fi

# Inventory scan clock. Starts at 0 so the first successful poll walks the tree
# immediately rather than leaving `/api/cloud/contexts/{id}/relays` answering
# "not servable" for the first scan interval after every boot.
LAST_INVENTORY_SCAN=0
# The confirmed set as it stood at the last scan. A join or a leave changes what
# this node can execute for, and waiting out the scan interval to notice
# something we already know is a pointless delay on the one signal core does
# give us for free.
LAST_INVENTORY_CONFIRMED=""
LAST_RECOVERY_SCAN=0
LAST_RECOVERY_CONFIRMED=""
# Executor-account retry clock. 0 so the first loop pass retries immediately
# when the startup read came up empty, rather than sitting out a full interval
# on the one boot where merod was only a moment behind.
LAST_ACCOUNT_ATTEMPT=0
# Registration retry clock. 0 so a node with no token registers on its first
# pass rather than waiting out an interval on every boot.
LAST_REGISTRATION_ATTEMPT=0

while true; do
  # SAFETY-CRITICAL GATE: only mutate state on a SUCCESSFUL poll.
  # poll_mdma returns 0 + a valid assignments body on HTTP 200, or 1 on any
  # curl error / non-2xx / timeout / unparseable body. On failure we do NOT
  # compute desired, do NOT join, do NOT leave, do NOT prune — we leave the
  # `confirmed` file untouched and continue. Preserving `confirmed` across a
  # failed poll is load-bearing for the leave logic: if a failed poll pruned
  # `confirmed`, a genuine disable on the next good poll would no longer show
  # up in `confirmed − desired` and the node would never leave.
  if ! response=$(poll_mdma "$PEER_ID" "$MRTD"); then
    sleep "$POLL_INTERVAL"
    continue
  fi

  # Desired state: every group mdma currently assigns this fleet node
  # to (returns existing 'assigned' + 'active' assignments via heartbeat).
  desired=$(echo "$response" | python3 -c "
import sys, json
try:
  data = json.load(sys.stdin)
  assignments = data.get('assignments', [])
  print(json.dumps(sorted([a['group_id'] for a in assignments])))
except:
  print('[]')
" 2>/dev/null || echo '[]')

  confirmed=$(load_confirmed)

  # Reconcile: for every desired group, retry fleet-join until our local
  # core admits us (response.admitted=true), then POST /confirm to mdma.
  # This is the convergence loop the prior `to_join = desired - STATE_FILE`
  # design lacked — if the owner was offline during the first 30s window,
  # the old code marked the assignment "tried" and never retried, so the
  # node stayed forever an `assigned` non-member. fleet-join is idempotent
  # in core (returns admitted=true immediately for an already-admitted
  # group), so re-running is cheap.
  for group_id in $(echo "$desired" | python3 -c "import sys,json; [print(g) for g in json.loads(sys.stdin.read())]" 2>/dev/null); do
    # Skip groups we've already confirmed. Membership is stable until
    # mdma drops the assignment (handled by the prune below).
    if echo "$confirmed" | python3 -c "import sys,json; sys.exit(0 if '$group_id' in json.load(sys.stdin) else 1)" 2>/dev/null; then
      continue
    fi
    if join_group "$group_id"; then
      # Only mark confirmed-locally when BOTH local admission AND mdma's
      # /confirm POST succeed. If /confirm fails (transient mdma blip),
      # leave the group out of CONFIRMED_FILE so the next cycle's
      # join_group returns admitted=true immediately (idempotent in
      # core) and we re-try /confirm — eventually consistent.
      # Report the authorship grant with the very first confirm, so a namespace
      # that ALREADY holds the grant (a re-joining node, a namespace whose admin
      # granted it before this replica existed) is advertised as writable
      # immediately instead of waiting for `reconcile_authorship` to spot a
      # change that never comes.
      authorship=$(check_authorship "$group_id")
      if confirm_assignment "$PEER_ID" "$group_id" "$authorship"; then
        log "Confirmed group $group_id with mdma (authorship_ready=$authorship)"
        confirmed=$(echo "$confirmed" | python3 -c "
import sys, json
c = json.load(sys.stdin)
c.append('$group_id')
print(json.dumps(sorted(set(c))))
" 2>>"$LOG" || echo "$confirmed")
        # Record what we just reported, so the reconcile pass below only fires
        # on an actual later change.
        save_authorship "$(load_authorship | python3 -c "
import sys, json
try:
  state = json.load(sys.stdin)
except Exception:
  state = {}
state['$group_id'] = $( [[ "$authorship" == "true" ]] && echo True || echo False )
print(json.dumps(state, sort_keys=True))
" 2>>"$LOG" || load_authorship)"
      fi
    fi
    # No `break`: keep iterating to give other assignments a fair shot
    # in this same poll cycle. fleet-join's 30s window is per-group.
  done

  # Leave dropped namespaces: to_leave = confirmed − desired. These are
  # namespaces we had confirmed membership in but which mdma no longer
  # assigns — HA disabled, slot reclaimed, or MRTD distrust. All mean "no
  # longer entitled", so we self-leave to make core evict us from the
  # namespace + all subgroups and purge our data + keys.
  #
  # This runs ONLY after a successful poll (gated at the top of the loop), and
  # BEFORE the intersection-prune below — we need the `confirmed − desired`
  # diff while `confirmed` still contains the dropped entries; the prune then
  # persists their removal. leave_group is idempotent / non-fatal.
  to_leave=$(python3 -c "
import json
des = set(json.loads('''$desired'''))
con = set(json.loads('''$confirmed'''))
print(json.dumps(sorted(con - des)))
" 2>>"$LOG" || echo '[]')

  for group_id in $(echo "$to_leave" | python3 -c "import sys,json; [print(g) for g in json.loads(sys.stdin.read())]" 2>/dev/null); do
    leave_group "$group_id"
  done

  # Prune confirmed: if mdma no longer assigns us to a group (HA
  # disabled, namespace deleted, slot reclaimed), drop it from the
  # confirmed set so a future re-add is recognised as new on the
  # next cycle.
  confirmed=$(python3 -c "
import json
des = set(json.loads('''$desired'''))
con = set(json.loads('''$confirmed'''))
print(json.dumps(sorted(con & des)))
" 2>/dev/null || echo '[]')

  save_confirmed "$confirmed"

  # Last, and over the pruned `confirmed` set: the authorship grant arrives
  # long after admission, so it has to be re-read for namespaces we already
  # hold. Runs after the prune so a namespace we just left is not re-reported.
  reconcile_authorship "$PEER_ID" "$confirmed"

  # The account, if the startup read came up empty. Must precede the
  # registration below, which cannot bind an identity without it.
  reconcile_executor_account

  # Attested registration. Cheap when nothing changed — a string compare
  # against the recorded identity — so it sits on the 1 Hz loop rather than a
  # timer of its own: until this succeeds mdma will not advertise the node as a
  # relay at all, so there is nothing to gain by waiting.
  reconcile_registration "$PEER_ID" "$EXECUTOR_ACCOUNT" "$RELAY_URL" "$SERVER_PORT"

  # Context inventory, also over the pruned set. Walking the group tree costs a
  # `meroctl` subprocess per group, so it runs on its own much slower clock than
  # this one-second loop — except when the confirmed set itself changed, which
  # is a membership change we already know about and should not sit on.
  now_ts=$(date +%s)
  if [[ "$confirmed" != "$LAST_INVENTORY_CONFIRMED" ]] \
     || (( now_ts - LAST_INVENTORY_SCAN >= INVENTORY_SCAN_INTERVAL )); then
    # A membership change forces the authoritative variant: a namespace this
    # node just left must stop being advertised now, and only a `full` post
    # prunes.
    force_full=false
    [[ -n "$LAST_INVENTORY_CONFIRMED" && "$confirmed" != "$LAST_INVENTORY_CONFIRMED" ]] && force_full=true
    reconcile_inventory "$PEER_ID" "$confirmed" "$force_full"
    LAST_INVENTORY_SCAN="$now_ts"
    LAST_INVENTORY_CONFIRMED="$confirmed"
  fi

  # Recovery envelopes, on their own much slower clock again: this adds a
  # `meroctl account seal-to` per changed account on top of the walk, for data
  # that moves on the order of days. A change to the confirmed set still forces
  # a pass — a namespace just joined has members whose recovery list is now
  # wrong, and waiting out the interval leaves them unrecoverable in the window.
  now_ts=$(date +%s)
  if [[ "$confirmed" != "$LAST_RECOVERY_CONFIRMED" ]] \
     || (( now_ts - LAST_RECOVERY_SCAN >= RECOVERY_SCAN_INTERVAL )); then
    recovery_full=false
    [[ -n "$LAST_RECOVERY_CONFIRMED" && "$confirmed" != "$LAST_RECOVERY_CONFIRMED" ]] && recovery_full=true
    reconcile_recovery "$PEER_ID" "$confirmed" "$recovery_full"
    LAST_RECOVERY_SCAN="$now_ts"
    LAST_RECOVERY_CONFIRMED="$confirmed"
  fi

  sleep "$POLL_INTERVAL"
done
